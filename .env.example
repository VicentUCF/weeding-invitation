# PostgreSQL dedicated to this wedding; apply db/schema.sql first.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB
PUBLIC_SITE_URL=https://your-domain.example
# Generate with: npm run admin:password -- 'a unique long password'
INVITATION_LINK_KEY=
# Option A: local single-admin login
ADMIN_EMAIL=
ADMIN_PASSWORD_SALT=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_KEY=
# Option B: Supabase Auth for individual accounts (leave Option A empty)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
ADMIN_USER_IDS=
