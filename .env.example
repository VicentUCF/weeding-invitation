# Supabase Transaction pooler URI (port 6543) for the server-side PostgreSQL connection.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres
PUBLIC_SITE_URL=https://your-domain.example
# Generate 32 random bytes encoded as base64; keep this key stable.
INVITATION_LINK_KEY=
# Supabase Auth project URL, publishable key, and authorized Auth user UUIDs.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
ADMIN_USER_IDS=
