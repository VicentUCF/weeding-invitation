---
interface Props { name: 'person' | 'group' | 'send' | 'copy' | 'check' | 'clock' | 'blocked' | 'undo' | 'manage' | 'view' | 'edit' | 'delete' }
const { name } = Astro.props;
---
<svg class="admin-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'person' && <><circle cx="12" cy="7.5" r="3.5" /><path d="M5 20v-1.5a7 7 0 0 1 14 0V20" /></>}
  {name === 'group' && <><circle cx="9" cy="8" r="3" /><path d="M3.5 19v-1a5.5 5.5 0 0 1 11 0v1M16 5.5a3 3 0 0 1 0 5.5M17 13a5 5 0 0 1 3.5 5v1" /></>}
  {name === 'send' && <><path d="m21 3-9.2 18-2.2-7.6L2 11.2 21 3Z" /><path d="M9.6 13.4 21 3" /></>}
  {name === 'copy' && <><rect x="8" y="8" width="12" height="12" rx="2" /><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2" /></>}
  {name === 'check' && <path d="m4 12 5 5L20 6" />}
  {name === 'clock' && <><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></>}
  {name === 'blocked' && <><circle cx="12" cy="12" r="9" /><path d="M5.6 5.6 18.4 18.4" /></>}
  {name === 'undo' && <><path d="M9 7H4V2M4 7a9 9 0 1 1-1 8" /></>}
  {name === 'manage' && <><path d="M4 19h16M4 12h16M4 5h16" /><circle cx="9" cy="5" r="2" fill="currentColor" stroke="none" /><circle cx="15" cy="12" r="2" fill="currentColor" stroke="none" /><circle cx="11" cy="19" r="2" fill="currentColor" stroke="none" /></>}
  {name === 'view' && <><path d="M2.5 12s3.5-5.5 9.5-5.5 9.5 5.5 9.5 5.5-3.5 5.5-9.5 5.5S2.5 12 2.5 12Z" /><circle cx="12" cy="12" r="2.5" /></>}
  {name === 'edit' && <><path d="M4 20h4l11-11-4-4L4 16v4ZM13.5 6.5l4 4" /></>}
  {name === 'delete' && <><path d="M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13M10 11v5M14 11v5" /></>}
</svg>
