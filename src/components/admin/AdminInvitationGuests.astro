---
import type { Invitation } from '../../lib/invitations.server';
interface Props { invitation: Invitation }
const { invitation } = Astro.props;
---
<section data-detail-part="guests" class="admin-section" aria-labelledby="personas-title"><div class="admin-section__heading"><div><p class="eyebrow">Resposta per persona</p><h2 id="personas-title">Persones convidades</h2></div><p>Les respostes sobre l’autobús, les dades alimentàries i les observacions anteriors només apareixen ací i en el CSV privat.</p></div>
      <div class="admin-guests">
        {invitation.guests.map((guest) => <article class="admin-guest" data-guest-id={guest.id}><form method="post" class="admin-form"><input type="hidden" name="action" value="editGuest" /><input type="hidden" name="guestId" value={guest.id} /><label for={`name-${guest.id}`}>Nom</label><input id={`name-${guest.id}`} name="name" maxlength="160" required value={guest.name} /><label for={`response-${guest.id}`}>Assistència</label><select id={`response-${guest.id}`} name="response"><option value="pending" selected={guest.response === 'pending'}>Pendent</option><option value="yes" selected={guest.response === 'yes'}>Assistirà</option><option value="no" selected={guest.response === 'no'}>No assistirà</option></select><label for={`allergies-${guest.id}`}>Al·lèrgies i intoleràncies</label><textarea id={`allergies-${guest.id}`} name="allergies" rows="3" maxlength="2000">{guest.allergies}</textarea><label for={`bus-${guest.id}`}>Plaça a l’autobús</label><select id={`bus-${guest.id}`} name="bus"><option value="" selected={guest.bus_seat === null}>Sense resposta</option><option value="yes" selected={guest.bus_seat === true}>Sí, reserva plaça</option><option value="no" selected={guest.bus_seat === false}>No necessita plaça</option></select><div data-admin-bus-route><label for={`bus-route-${guest.id}`}>Trajecte de l’autobús</label><select id={`bus-route-${guest.id}`} name="busRoute"><option value="" selected={guest.bus_route === null}>Sense especificar</option><option value="outbound" selected={guest.bus_route === 'outbound'}>Només anada</option><option value="return" selected={guest.bus_route === 'return'}>Només tornada</option><option value="both" selected={guest.bus_route === 'both'}>Anada i tornada</option></select></div><label class="admin-checkbox"><input type="checkbox" name="consent" value="yes" checked={guest.food_data_consent} /> Tinc permís per a registrar estes dades alimentàries</label><label for={`observations-${guest.id}`}>Altres observacions</label><textarea id={`observations-${guest.id}`} name="observations" rows="3" maxlength="1000">{guest.observations}</textarea><p class="admin-guest__date">{guest.responded_at ? `Va respondre el ${guest.responded_at.toLocaleDateString('ca-ES')}` : 'Sense resposta'}</p><button class="button button--primary" type="submit">Guarda la resposta</button></form><form method="post" data-confirm="Vols llevar esta persona i eliminar la seua resposta?"><input type="hidden" name="action" value="removeGuest" /><input type="hidden" name="guestId" value={guest.id} /><button class="admin-link admin-link--danger" type="submit">Lleva la persona</button></form></article>)}
      </div>
      <form method="post" class="admin-add-guest"><input type="hidden" name="action" value="addGuest" /><label for="new-guest">Afig una persona a esta invitació</label><input id="new-guest" name="name" maxlength="160" required /><button class="button" type="submit">Afig</button></form>
    </section>
