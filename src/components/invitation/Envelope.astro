---
import { wedding } from '../../config/wedding';
import { t, type Locale } from '../../lib/i18n';
interface Props { locale?: Locale }
const locale = Astro.props.locale ?? 'es';
const c = t(locale);
const dateLong = new Date(`${wedding.date}T12:00:00Z`).toLocaleDateString(locale === 'uk' ? 'uk-UA' : 'ca-ES', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<section class="opening" data-opening aria-label={c.openLabel}>
  <div class="opening__frame" aria-hidden="true"></div>
  <img class="opening__floral opening__floral--left" src="/images/olive-corner.webp" alt="" width="1200" height="800" />
  <img class="opening__floral opening__floral--right" src="/images/olive-corner.webp" alt="" width="1200" height="800" />
  <img class="opening__petals" src="/images/petal-trail.webp" alt="" width="1000" height="667" />
  <img class="opening__petals opening__petals--approach" src="/images/petal-trail.webp" alt="" width="1000" height="667" />
  <div class="opening__content">
    <p class="opening__eyebrow">{c.special}</p>
    <p class="opening__names">{wedding.couple.join(locale === 'uk' ? ' та ' : ' i ')}</p>
    <p class="opening__date"><time datetime={wedding.date}>{dateLong}</time></p>
    <div class="envelope" data-envelope>
      <div class="envelope__glow" aria-hidden="true"></div>
      <div class="envelope__back" aria-hidden="true"></div>
      <div class="envelope__letter" data-letter aria-hidden="true" inert>
        <div class="invitation-card" data-card></div>
      </div>
      <div class="envelope__front" data-envelope-front aria-hidden="true">
        <div class="envelope__side envelope__side--left"></div>
        <div class="envelope__side envelope__side--right"></div>
        <div class="envelope__bottom"></div>
      </div>
      <div class="envelope__lid" data-flap>
        <div class="envelope__flap" aria-hidden="true"></div>
        <button class="envelope__seal" data-open type="button" aria-label={`${c.open} ${wedding.couple.join(' i ')}`}>
          <img src="/images/seal-transparent.png" alt="" width="320" height="312" fetchpriority="high" />
        </button>
      </div>
      <span class="envelope__spark envelope__spark--one" aria-hidden="true">✦</span>
      <span class="envelope__spark envelope__spark--two" aria-hidden="true">✧</span>
      <span class="envelope__spark envelope__spark--three" aria-hidden="true">✦</span>
      <span class="envelope__spark envelope__spark--four" aria-hidden="true">✧</span>
    </div>
    <p class="opening__hint">{c.hint}</p>
    <button class="opening__skip" data-skip type="button">{c.skipAnimation}</button>
  </div>
  <button class="opening__sound" data-sound-toggle data-sound-on={c.soundOn} data-sound-off={c.soundOff} type="button" aria-label={c.soundOn} aria-pressed="true">
    <span aria-hidden="true">♪</span>
    <span data-sound-label>{c.soundOn}</span>
  </button>
  <audio data-opening-audio src="/sounds/envelope-opening.mp3" preload="auto"></audio>
</section>
