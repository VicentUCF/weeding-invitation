---
import InvitationPaper from './InvitationPaper.astro';
import type { InvitationRecipient } from '../../config/recipients';
import type { Locale } from '../../lib/i18n';
interface Props { greeting?: string; message?: string; recipient?: InvitationRecipient; locale?: Locale }
const { greeting, message, recipient, locale = 'es' } = Astro.props;
---
<section class="hero" aria-labelledby="hero-title">
  <InvitationPaper recipient={recipient} greeting={greeting} message={message} locale={locale} />
</section>
