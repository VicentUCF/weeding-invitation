---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Envelope from './Envelope.astro';
import InvitationHero from './InvitationHero.astro';
import WeddingDetails from './WeddingDetails.astro';
import Journey from './Journey.astro';
import Timeline from './Timeline.astro';
import RSVPForm from '../rsvp/RSVPForm.astro';
import type { Invitation, Settings } from '../../lib/invitations.server';
import { wedding } from '../../config/wedding';
import { htmlLang, invitationPath, localeName, locales, t, type Locale } from '../../lib/i18n';
import type { InvitationRecipient } from '../../config/recipients';
interface Props { recipient?: InvitationRecipient; invitation?: Invitation; rsvpSettings?: Settings; rsvpError?: string; rsvpSaved?: boolean; rsvpSubmitted?: FormData; preview?: boolean; locale?: Locale }
const { recipient, invitation, rsvpSettings, rsvpError, rsvpSaved, rsvpSubmitted, preview = false, locale = 'es' } = Astro.props;
const c = t(locale);
---
<BaseLayout preview={preview} privatePage={!preview} locale={locale}>
  <script is:inline>
    document.documentElement.classList.add('has-js');
    window.setTimeout(() => {
      if (document.documentElement.dataset.envelopeReady !== 'true') {
        document.documentElement.classList.add('invitation-open');
      }
    }, 8000);
  </script>
  <Envelope locale={locale} />
  <div class="invitation" id="invitation-content">
    {recipient && <nav class="language-switch" aria-label={locale === 'uk' ? 'Мова запрошення' : 'Idioma de la invitació'}>
      {locales.map((option) => <a href={`${invitationPath(recipient.token, option)}?lang=${option}`} lang={htmlLang[option]} aria-current={option === locale ? 'page' : undefined}>{localeName[option]}</a>)}
    </nav>}
    <InvitationHero recipient={recipient} locale={locale} />
    <Journey locale={locale} />
    <WeddingDetails locale={locale} />
    <div class="journey-art-handoff" data-journey-art-handoff aria-hidden="true">
      <img src="/images/galim-aerial-sheet.webp" alt="" width="1383" height="922" decoding="async" />
    </div>
    <div class="journey-name-handoff" data-journey-name-handoff aria-hidden="true">{wedding.ceremony.venue}</div>
    <Timeline locale={locale} />
    {invitation && rsvpSettings
      ? <RSVPForm invitation={invitation} settings={rsvpSettings} error={rsvpError} saved={rsvpSaved} submitted={rsvpSubmitted} locale={locale} />
      : preview && <RSVPForm preview locale={locale} />}
    <footer class="footer">
      <p>{c.farewell}</p>
      <strong>{wedding.couple.join(locale === 'uk' ? ' та ' : ' i ')}</strong>
      <small>{c.footer}</small>
    </footer>
  </div>
  <script>
    import { createTimeline } from 'animejs';

    const html = document.documentElement;
    const opening = document.querySelector<HTMLElement>('[data-opening]');
    const invitation = document.querySelector<HTMLElement>('.invitation');
    const envelope = document.querySelector<HTMLElement>('[data-envelope]');
    const front = document.querySelector<HTMLElement>('[data-envelope-front]');
    const seal = document.querySelector<HTMLButtonElement>('[data-open]');
    const skip = document.querySelector<HTMLButtonElement>('[data-skip]');
    const flap = document.querySelector<HTMLElement>('[data-flap]');
    const letter = document.querySelector<HTMLElement>('[data-letter]');
    const card = document.querySelector<HTMLElement>('[data-card]');
    const paper = document.querySelector<HTMLElement>('[data-paper="full"]');
    const hero = document.querySelector<HTMLElement>('.hero');
    const heading = document.querySelector<HTMLElement>('#hero-title');
    const returnToRsvp = window.location.hash === '#confirmar' || new URLSearchParams(window.location.search).has('saved') || !!document.querySelector('[data-form-error]');

    if (returnToRsvp) {
      if (hero && paper) {
        hero.appendChild(paper);
        paper.classList.remove('hero__paper--mini');
        paper.dataset.paper = 'full';
      }
      html.classList.add('invitation-open');
      window.requestAnimationFrame(() => {
        document.querySelector<HTMLElement>('[data-form-error], .form-message--success, #confirmar')?.scrollIntoView({ block: 'start' });
        document.querySelector<HTMLElement>('[data-form-error], .form-message--success')?.focus({ preventScroll: true });
      });
    } else if (opening && invitation && envelope && front && seal && skip && flap && letter && card && paper && hero && heading) {
      window.scrollTo(0, 0);
      invitation.inert = true;
      html.dataset.envelopeReady = 'true';
      const destination = paper.getBoundingClientRect();
      if (window.innerWidth > 800) {
        card.style.setProperty('--mini-card-width', `${destination.width}px`);
        card.style.setProperty('--mini-card-height', `${destination.height}px`);
      }
      card.appendChild(paper);
      paper.classList.add('hero__paper--mini');
      paper.dataset.paper = 'mini';

      const fitMiniPaper = () => {
        const scale = Math.min(letter.clientWidth / card.offsetWidth, letter.clientHeight / card.offsetHeight);
        card.style.setProperty('--mini-scale', String(scale));
      };
      fitMiniPaper();
      const resizeObserver = new ResizeObserver(fitMiniPaper);
      resizeObserver.observe(letter);

      const reveal = () => {
        resizeObserver.disconnect();
        hero.appendChild(paper);
        paper.classList.remove('hero__paper--mini');
        paper.dataset.paper = 'full';
        html.classList.add('invitation-open');
        invitation.inert = false;
        opening.hidden = true;
        const visibleHeading = document.querySelector<HTMLElement>('#hero-title');
        visibleHeading?.setAttribute('tabindex', '-1');
        visibleHeading?.focus({ preventScroll: true });
      };

      const enterPaper = async () => {
        reveal();
        const distance = paper.getBoundingClientRect().bottom + 24;
        const animation = paper.animate(
          [
            { transform: `translateY(-${distance}px)`, offset: 0, easing: 'cubic-bezier(.15, .85, .22, 1)' },
            { transform: 'translateY(18px)', offset: .78, easing: 'cubic-bezier(.25, 0, .3, 1)' },
            { transform: 'translateY(-6px)', offset: .91, easing: 'ease-out' },
            { transform: 'none', offset: 1 },
          ],
          { duration: 1100, fill: 'both' },
        );
        await animation.finished;
        animation.cancel();
      };

      const moveLetter = async (
        waypoint: { left: number; top: number; width: number; height: number },
        target: { left: number; top: number; width: number; height: number },
      ) => {
        const start = letter.getBoundingClientRect();
        const animation = letter.animate(
          [
            { left: `${start.left}px`, top: `${start.top}px`, width: `${start.width}px`, height: `${start.height}px`, offset: 0, easing: 'cubic-bezier(.35, 0, .65, 1)' },
            { left: `${waypoint.left}px`, top: `${waypoint.top}px`, width: `${waypoint.width}px`, height: `${waypoint.height}px`, offset: .62 },
            { left: `${waypoint.left}px`, top: `${waypoint.top}px`, width: `${waypoint.width}px`, height: `${waypoint.height}px`, offset: .76, easing: 'cubic-bezier(.65, 0, 1, 1)' },
            { left: `${target.left}px`, top: `${target.top}px`, width: `${target.width}px`, height: `${target.height}px`, offset: 1 },
          ],
          { duration: 1900, fill: 'forwards' },
        );
        await animation.finished;
        Object.assign(letter.style, {
          left: `${target.left}px`, top: `${target.top}px`, width: `${target.width}px`, height: `${target.height}px`,
        });
        animation.cancel();
      };

      const continueOpening = async () => {
        try {
          const start = letter.getBoundingClientRect();
          opening.appendChild(letter);
          Object.assign(letter.style, {
            position: 'fixed', inset: 'auto', left: `${start.left}px`, top: `${start.top}px`,
            width: `${start.width}px`, height: `${start.height}px`, transform: 'none', zIndex: '7',
          });
          fitMiniPaper();

          const envelopeStart = envelope.getBoundingClientRect();
          opening.appendChild(front);
          Object.assign(front.style, { position: 'fixed', inset: 'auto', zIndex: '8' });
          let trackingFront = true;
          const alignFront = () => {
            if (!trackingFront || opening.hidden) return;
            const bounds = envelope.getBoundingClientRect();
            Object.assign(front.style, {
              left: `${bounds.left}px`, top: `${bounds.top}px`,
              width: `${bounds.width}px`, height: `${bounds.height}px`,
              opacity: getComputedStyle(envelope).opacity,
            });
            window.requestAnimationFrame(alignFront);
          };
          alignFront();
          const waypointWidth = Math.max(start.width, Math.min(destination.width * .8, start.width * 1.1));
          const waypointHeight = waypointWidth * card.offsetHeight / card.offsetWidth;
          const waypoint = {
            left: start.left + (start.width - waypointWidth) / 2,
            top: Math.max(12, start.top - Math.min(100, window.innerHeight * .12)),
            width: waypointWidth,
            height: waypointHeight,
          };
          const target = {
            left: waypoint.left, top: -waypointHeight - 40,
            width: waypointWidth, height: waypointHeight,
          };
          const envelopeDrop = Math.max(0, waypoint.top + waypoint.height + 40 - envelopeStart.top);
          const envelopeFinalDrop = Math.max(envelopeDrop, window.innerHeight + 40 - envelopeStart.top);
          opening.classList.add('opening--approaching');
          await Promise.all([
            moveLetter(waypoint, target),
            letter.animate([
              { transform: 'translateY(0) rotate(0deg)', offset: 0 },
              { transform: 'translateY(-7px) rotate(-.8deg)', offset: .62 },
              { transform: 'translateY(-7px) rotate(-.8deg)', offset: .76 },
              { transform: 'translateY(0) rotate(0deg)', offset: 1 },
            ], { duration: 1900, easing: 'ease-in-out' }).finished,
            envelope.animate([
              { top: '0px', opacity: 1, offset: 0, easing: 'cubic-bezier(.35, 0, .65, 1)' },
              { top: `${envelopeDrop}px`, opacity: 1, offset: .62 },
              { top: `${envelopeDrop}px`, opacity: 1, offset: .76, easing: 'cubic-bezier(.65, 0, 1, 1)' },
              { top: `${envelopeFinalDrop}px`, opacity: 0, offset: 1 },
            ], { duration: 1900, fill: 'forwards' }).finished,
          ]);
          trackingFront = false;
          front.style.opacity = '0';
          await enterPaper();
        } catch {
          reveal();
        }
      };

      skip.addEventListener('click', () => {
        html.classList.add('invitation-skip');
        reveal();
      }, { once: true });
      seal.addEventListener('click', () => {
        seal.disabled = true;
        skip.disabled = true;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          reveal();
          return;
        }

        opening.dataset.state = 'opening';
        try {
          createTimeline({
            defaults: { ease: 'inOut(3)' },
            onUpdate: () => {
              // Switch layers at the edge-on frame: the opened flap sits behind the letter.
              const flapTurn = new DOMMatrixReadOnly(getComputedStyle(flap).transform);
              const openedPastEdge = flapTurn.m22 <= 0;
              flap.style.zIndex = openedPastEdge ? '1' : '3';
              seal.style.visibility = openedPastEdge ? 'hidden' : 'visible';
            },
            onComplete: () => { void continueOpening(); },
          })
            .add(flap, { rotateX: [0, '-80deg'], duration: 650, ease: 'out(2)' }, 0)
            .add(flap, { rotateX: ['-80deg', '-180deg'], duration: 450, ease: 'inOut(2)' }, 650)
            .call(() => { flap.classList.add('envelope__lid--open'); }, 1100)
            .add(letter, { y: ['0%', '-43%'], duration: 500, ease: 'out(3)' }, 1150)
            .add(envelope, { y: [0, 15], scale: [1, 1.03], duration: 500, ease: 'inOut(2)' }, 1150);
        } catch {
          reveal();
        }
      }, { once: true });
    } else {
      html.classList.add('invitation-open');
    }

    const revealTargets = [...document.querySelectorAll<HTMLElement>('[data-scroll-reveal]')];
    if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const observer = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      }, { threshold: 0.12, rootMargin: '0px 0px -30px 0px' });
      revealTargets.forEach((target) => observer.observe(target));
      html.classList.add('scroll-reveal-ready');
    }

    const journey = document.querySelector<HTMLElement>('[data-journey]');
    const routePath = journey?.querySelector<SVGPathElement>('[data-route-path]');
    const routeMask = journey?.querySelector<SVGPathElement>('[data-route-mask]');
    const routeStartMask = journey?.querySelector<SVGCircleElement>('[data-route-start-mask]');
    const routeEndMask = journey?.querySelector<SVGCircleElement>('[data-route-end-mask]');
    const roadLine = journey?.querySelector<SVGSVGElement>('.journey__roadline');
    const car = journey?.querySelector<HTMLElement>('[data-journey-car]');
    const venuePreview = journey?.querySelector<HTMLElement>('[data-journey-preview]');
    const venuePreviewName = journey?.querySelector<HTMLElement>('[data-journey-name]');
    const venueCard = document.querySelector<HTMLElement>('[data-journey-card]');
    const venueHeading = document.querySelector<HTMLElement>('[data-journey-heading]');
    const venueArt = venueCard?.querySelector<HTMLElement>('.venue-card__art--aerial');
    const venueName = venueCard?.querySelector<HTMLElement>('h3');
    const handoff = document.querySelector<HTMLElement>('[data-journey-art-handoff]');
    const nameHandoff = document.querySelector<HTMLElement>('[data-journey-name-handoff]');
    if (journey && routePath && routeMask && routeStartMask && routeEndMask && roadLine && car) {
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const steps = [...journey.querySelectorAll<HTMLElement>('[data-journey-step]')];
      if ('IntersectionObserver' in window && !reduceMotion.matches) {
        const stepObserver = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add('is-visible');
            stepObserver.unobserve(entry.target);
          }
        }, { threshold: 0.16 });
        steps.forEach((step) => stepObserver.observe(step));
        html.classList.add('journey-reveal-ready');
      }
      let frame = 0;
      const updateJourney = () => {
        frame = 0;
        if (reduceMotion.matches) {
          routeMask.style.removeProperty('stroke-dasharray');
          routeMask.style.removeProperty('stroke-dashoffset');
          routeStartMask.style.removeProperty('opacity');
          routeEndMask.style.removeProperty('opacity');
          car.style.removeProperty('opacity');
          car.style.removeProperty('left');
          car.style.removeProperty('top');
          car.style.removeProperty('transform');
          html.classList.remove('journey-card-motion');
          venuePreview?.style.removeProperty('opacity');
          venuePreviewName?.style.removeProperty('opacity');
          handoff?.style.removeProperty('opacity');
          nameHandoff?.style.removeProperty('opacity');
          return;
        }
        const bounds = roadLine.getBoundingClientRect();
        const progress = Math.max(0, Math.min(1, (window.innerHeight * .72 - bounds.top) / bounds.height));
        const length = routePath.getTotalLength();
        const roadLength = progress > .002 ? length * progress : 0;
        routeMask.style.strokeDasharray = `${length} ${length}`;
        routeMask.style.strokeDashoffset = `${length - roadLength}`;
        routeStartMask.style.opacity = progress > .002 ? '1' : '0';
        routeEndMask.style.opacity = progress >= .999 ? '1' : '0';
        const point = routePath.getPointAtLength(length * progress);
        const next = routePath.getPointAtLength(Math.min(length, length * progress + 2));
        const previous = routePath.getPointAtLength(Math.max(0, length * progress - 2));
        const angle = Math.atan2((next.y - previous.y) * bounds.height / 1220, (next.x - previous.x) * bounds.width / 500) * 180 / Math.PI + 90;
        car.style.left = `${point.x / 500 * 100}%`;
        car.style.top = `${point.y / 1000 * 100}%`;
        car.style.transform = `translate(-50%, -50%) rotate(${angle}deg)`;
        car.style.opacity = progress > .005 ? '1' : '0';

        if (venuePreview && venuePreviewName && venueCard && venueArt && venueName && handoff && nameHandoff) {
          html.classList.add('journey-card-motion');
          const sourceBounds = venuePreview.getBoundingClientRect();
          const documentPosition = (element: HTMLElement) => {
            let top = 0;
            let left = 0;
            for (let node: HTMLElement | null = element; node; node = node.offsetParent as HTMLElement | null) {
              top += node.offsetTop;
              left += node.offsetLeft;
            }
            return { top, left };
          };
          const sourcePosition = documentPosition(venuePreview);
          const targetPosition = documentPosition(venueArt);
          const sourceNamePosition = documentPosition(venuePreviewName);
          const targetNamePosition = documentPosition(venueName);
          const sourceNameBounds = venuePreviewName.getBoundingClientRect();
          const start = sourcePosition.top + venuePreview.offsetHeight * .15 - window.innerHeight * .72;
          const headingTop = venueHeading ? documentPosition(venueHeading).top : Number.POSITIVE_INFINITY;
          const finish = Math.min(targetPosition.top - window.innerHeight * .36, headingTop - 24);
          const handoffProgress = Math.max(0, Math.min(1, (window.scrollY - start) / Math.max(1, finish - start)));
          const moveProgress = Math.max(0, Math.min(1, (handoffProgress - .06) / .94));
          const nameProgress = Math.max(0, Math.min(1, (handoffProgress - .06) / .75));
          const blend = (from: number, to: number) => from + (to - from) * moveProgress;
          const blendName = (from: number, to: number) => from + (to - from) * nameProgress;
          const cardVisible = handoffProgress >= .92 || venueCard.contains(document.activeElement);
          venueCard.classList.toggle('is-journey-visible', cardVisible);
          venueHeading?.classList.toggle('is-journey-visible', cardVisible);
          const artArrived = handoffProgress >= .99 || venueCard.contains(document.activeElement);
          venueCard.classList.toggle('is-journey-arrived', artArrived);
          handoff.classList.toggle('is-arrived', artArrived);
          nameHandoff.classList.toggle('is-arrived', artArrived);
          venuePreview.style.opacity = String(1 - Math.min(1, handoffProgress / .06));
          venuePreviewName.style.opacity = String(1 - Math.min(1, handoffProgress / .06));
          handoff.style.opacity = artArrived ? '0' : String(Math.min(1, handoffProgress / .06));
          nameHandoff.style.opacity = artArrived ? '0' : String(Math.min(1, handoffProgress / .06));
          handoff.style.width = `${blend(sourceBounds.width, venueArt.offsetWidth)}px`;
          handoff.style.height = `${blend(sourceBounds.height, venueArt.offsetHeight)}px`;
          handoff.style.transform = `translate3d(${blend(sourcePosition.left, targetPosition.left) - window.scrollX}px, ${blend(sourcePosition.top, targetPosition.top) - window.scrollY}px, 0)`;
          nameHandoff.style.width = `${blendName(sourceNameBounds.width, venueName.offsetWidth)}px`;
          nameHandoff.style.height = `${blendName(sourceNameBounds.height, venueName.offsetHeight)}px`;
          nameHandoff.style.fontSize = `${blendName(parseFloat(getComputedStyle(venuePreviewName).fontSize), parseFloat(getComputedStyle(venueName).fontSize))}px`;
          nameHandoff.style.transform = `translate3d(${blendName(sourceNamePosition.left, targetNamePosition.left) - window.scrollX}px, ${blendName(sourceNamePosition.top, targetNamePosition.top) - window.scrollY}px, 0)`;
        }
      };
      const requestJourneyUpdate = () => {
        if (!frame) frame = window.requestAnimationFrame(updateJourney);
      };
      window.addEventListener('scroll', requestJourneyUpdate, { passive: true });
      window.addEventListener('resize', requestJourneyUpdate);
      reduceMotion.addEventListener('change', requestJourneyUpdate);
      venueCard?.addEventListener('focusin', requestJourneyUpdate);
      window.addEventListener('load', requestJourneyUpdate, { once: true });
      updateJourney();
    }
  </script>
</BaseLayout>
