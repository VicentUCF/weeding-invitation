---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { requireAdmin, signIn } from '../../lib/auth.server';
import { sameOrigin } from '../../lib/security.server';
export const prerender = false;
if (await requireAdmin(Astro)) return Astro.redirect('/admin/', 303);
let error = '';
if (Astro.request.method === 'POST') {
  if (!sameOrigin(Astro)) return new Response('Origen no válido', { status: 403 });
  const data = await Astro.request.formData();
  try {
    if (await signIn(Astro, String(data.get('email') ?? '').trim(), String(data.get('password') ?? ''))) return Astro.redirect('/admin/', 303);
    error = 'Correo, contraseña o acceso no válidos.';
  } catch {
    error = 'El acceso no está configurado o no está disponible. Inténtalo más tarde.';
  }
}
---
<BaseLayout title="Acceso privado · Boda" privatePage>
  <div class="admin-login">
    <form method="post" class="admin-login__card">
      <p class="eyebrow">Espacio de los novios</p>
      <h1>Acceso privado</h1>
      <p>Gestiona las invitaciones y las respuestas de tus invitados.</p>
      {error && <p class="form-message form-message--error" role="alert">{error}</p>}
      <label for="email">Correo electrónico</label>
      <input id="email" type="email" name="email" autocomplete="username" required />
      <label for="password">Contraseña</label>
      <input id="password" type="password" name="password" autocomplete="current-password" required />
      <button class="button button--primary" type="submit">Entrar</button>
    </form>
  </div>
</BaseLayout>
