---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { requireAdmin, signOut } from '../../lib/auth.server';
import { sameOrigin } from '../../lib/security.server';
import { listInvitations, listGroups, createGroup, updateGroup, settings, createInvitation, saveSettings } from '../../lib/invitations.server';
import { invitationInput, guestNames, formField, requiredField } from '../../lib/forms.server';
import { localeName, parseLocale } from '../../lib/i18n';

export const prerender = false;
if (!await requireAdmin(Astro)) return Astro.redirect('/admin/login', 303);
let error = '';
if (Astro.request.method === 'POST') {
  if (!sameOrigin(Astro)) return new Response('Origen no válido', { status: 403 });
  const data = await Astro.request.formData();
  try {
    const action = formField(data, 'action');
    if (action === 'logout') { signOut(Astro); return Astro.redirect('/admin/login', 303); }
    if (action === 'create') {
      const id = await createInvitation({ ...invitationInput(data), names: guestNames(data) });
      return Astro.redirect(`/admin/invitations/${id}?created=1`, 303);
    }
    if (action === 'createGroup') {
      await createGroup(requiredField(formField(data, 'name'), 160, 'Nombre del grupo'), parseLocale(formField(data, 'locale')));
      return Astro.redirect('/admin/?groupSaved=1#grupos', 303);
    }
    if (action === 'editGroup') {
      await updateGroup(formField(data, 'groupId'), requiredField(formField(data, 'name'), 160, 'Nombre del grupo'), parseLocale(formField(data, 'locale')));
      return Astro.redirect('/admin/?groupSaved=1#grupos', 303);
    }
    if (action === 'settings') {
      const deadline = formField(data, 'deadline');
      if (deadline && (!/^\d{4}-\d{2}-\d{2}$/.test(deadline) || Number.isNaN(Date.parse(deadline)))) throw new Error('La fecha límite no es válida.');
      await saveSettings({ rsvp_enabled: formField(data, 'enabled') === 'yes', rsvp_deadline: deadline || null });
      return Astro.redirect('/admin/?saved=1', 303);
    }
    throw new Error('Acción no válida.');
  } catch (cause) { error = cause instanceof Error ? cause.message : 'No se pudieron guardar los cambios.'; }
}
let invitations = [] as Awaited<ReturnType<typeof listInvitations>>;
let groups = [] as Awaited<ReturnType<typeof listGroups>>;
let config: Awaited<ReturnType<typeof settings>> = { rsvp_enabled: true, rsvp_deadline: null };
try { [invitations, groups, config] = await Promise.all([listInvitations(), listGroups(), settings()]); }
catch { error = 'No se puede conectar con la base de datos. Revisa la configuración y el esquema.'; }
const activeInvitations = invitations.filter((invitation) => !invitation.revoked_at);
const guests = activeInvitations.flatMap((invitation) => invitation.guests);
const count = (response: string) => guests.filter((guest) => guest.response === response).length;
const search = Astro.url.searchParams.get('q')?.toLocaleLowerCase('es').trim() ?? '';
const status = Astro.url.searchParams.get('status') ?? 'all';
const groupFilter = Astro.url.searchParams.get('group') ?? 'all';
const filtered = invitations.filter((invitation) => {
  const matchesText = !search || [invitation.addressee, invitation.email ?? '', ...invitation.guests.map((guest) => guest.name)].some((part) => part.toLocaleLowerCase('es').includes(search));
  const matchesStatus = status === 'all' || (status === 'revoked' ? Boolean(invitation.revoked_at) : status === 'unsent' ? !invitation.sent_at : invitation.guests.some((guest) => guest.response === status));
  return matchesText && matchesStatus && (groupFilter === 'all' || (groupFilter === 'none' ? !invitation.group_id : invitation.group_id === groupFilter));
});
---
<BaseLayout title="Panel de invitaciones · Boda" privatePage>
  <div class="admin-shell">
    <header class="admin-header">
      <div><p class="eyebrow">Espacio de los novios</p><h1>Invitaciones y respuestas</h1></div>
      <form method="post"><input type="hidden" name="action" value="logout" /><button type="submit" class="admin-link">Cerrar sesión</button></form>
    </header>
    <nav class="admin-nav" aria-label="Secciones del panel"><a href="#resumen">Resumen</a><a href="#invitaciones">Invitaciones</a><a href="#grupos">Grupos e idiomas</a><a href="#nueva">Nueva invitación</a><a href="#ajustes">Ajustes</a><a href="/admin/export.csv">Exportar CSV</a></nav>
    {error && <p class="form-message form-message--error" role="alert">{error}</p>}
    {Astro.url.searchParams.has('saved') && <p class="form-message form-message--success" role="status">Ajustes guardados.</p>}
    {Astro.url.searchParams.has('groupSaved') && <p class="form-message form-message--success" role="status">Grupo e idioma guardados.</p>}
    {Astro.url.searchParams.has('deleted') && <p class="form-message form-message--success" role="status">Invitación y respuestas eliminadas.</p>}
    <section id="resumen" class="admin-section" aria-labelledby="resumen-title">
      <div class="admin-section__heading"><div><p class="eyebrow">Resumen</p><h2 id="resumen-title">Así van las respuestas</h2></div><p>Datos actualizados al abrir esta página.</p></div>
      <div class="admin-stats">
        <div><strong>{activeInvitations.length}</strong><span>Invitaciones activas</span></div>
        <div><strong>{guests.length}</strong><span>Personas invitadas</span></div>
        <div><strong>{count('yes')}</strong><span>Asisten</span></div>
        <div><strong>{count('no')}</strong><span>No asisten</span></div>
        <div><strong>{count('pending')}</strong><span>Pendientes</span></div>
        <div><strong>{guests.filter((guest) => guest.response === 'yes' && guest.allergies).length}</strong><span>Con alergias</span></div>
      </div>
    </section>
    <section id="invitaciones" class="admin-section" aria-labelledby="invitaciones-title">
      <div class="admin-section__heading"><div><p class="eyebrow">Seguimiento</p><h2 id="invitaciones-title">Invitaciones</h2></div><a class="button" href="/admin/export.csv">Descargar lista CSV</a></div>
      <form method="get" class="admin-filters" role="search">
        <label for="q">Buscar por nombre o correo</label><input id="q" name="q" type="search" value={Astro.url.searchParams.get('q') ?? ''} />
        <label for="status">Estado</label><select id="status" name="status"><option value="all" selected={status === 'all'}>Todos</option><option value="pending" selected={status === 'pending'}>Con pendientes</option><option value="yes" selected={status === 'yes'}>Con asistentes</option><option value="no" selected={status === 'no'}>Con ausencias</option><option value="unsent" selected={status === 'unsent'}>Sin enviar</option><option value="revoked" selected={status === 'revoked'}>Revocadas</option></select>
        <label for="group-filter">Grupo</label><select id="group-filter" name="group"><option value="all" selected={groupFilter === 'all'}>Todos</option><option value="none" selected={groupFilter === 'none'}>Sin grupo</option>{groups.map((group) => <option value={group.id} selected={groupFilter === group.id}>{group.name}</option>)}</select>
        <button class="button" type="submit">Filtrar</button>
      </form>
      {filtered.length ? <div class="admin-invitation-list">
        {filtered.map((invitation) => <article class="admin-invitation">
          <div><p class="admin-invitation__meta">{invitation.revoked_at ? 'Revocada' : invitation.sent_at ? 'Marcada como enviada' : 'Pendiente de envío'} · {groups.find((group) => group.id === invitation.group_id)?.name ?? 'Sin grupo'} · {localeName[invitation.locale]}</p><h3>{invitation.addressee}</h3><p>{invitation.guests.map((guest) => guest.name).join(', ')}</p>{invitation.email && <p>{invitation.email}</p>}</div>
          <div class="admin-invitation__side"><span>{invitation.guests.filter((guest) => guest.response === 'yes').length} sí · {invitation.guests.filter((guest) => guest.response === 'no').length} no · {invitation.guests.filter((guest) => guest.response === 'pending').length} pendientes</span><a class="button" href={`/admin/invitations/${invitation.id}`}>Gestionar</a></div>
        </article>)}
      </div> : <p class="admin-empty">{invitations.length ? 'No hay invitaciones que coincidan con este filtro.' : 'Todavía no hay invitaciones. Crea la primera abajo.'}</p>}
    </section>
    <section id="grupos" class="admin-section" aria-labelledby="grupos-title">
      <div class="admin-section__heading"><div><p class="eyebrow">Organizar</p><h2 id="grupos-title">Grupos e idiomas</h2></div><p>Las tarjetas de un grupo usan su idioma. Al cambiarlo, se actualizan sus enlaces.</p></div>
      {groups.map((group) => <form method="post" class="admin-form"><input type="hidden" name="action" value="editGroup" /><input type="hidden" name="groupId" value={group.id} /><label for={`group-name-${group.id}`}>Nombre del grupo</label><input id={`group-name-${group.id}`} name="name" value={group.name} maxlength="160" required /><label for={`group-locale-${group.id}`}>Idioma del grupo</label><select id={`group-locale-${group.id}`} name="locale"><option value="es" selected={group.locale === 'es'}>Español</option><option value="uk" selected={group.locale === 'uk'}>Українська</option></select><button class="button" type="submit">Guardar grupo</button></form>)}
      <form method="post" class="admin-form"><input type="hidden" name="action" value="createGroup" /><label for="new-group-name">Nuevo grupo</label><input id="new-group-name" name="name" maxlength="160" required placeholder="Ej.: Familia de Ucrania" /><label for="new-group-locale">Idioma predeterminado</label><select id="new-group-locale" name="locale"><option value="es">Español</option><option value="uk">Українська</option></select><button class="button button--primary" type="submit">Crear grupo</button></form>
    </section>
    <section id="nueva" class="admin-section" aria-labelledby="nueva-title">
      <div class="admin-section__heading"><div><p class="eyebrow">Preparar</p><h2 id="nueva-title">Nueva invitación</h2></div><p>Un enlace privado para todas las personas de esta tarjeta.</p></div>
      <form method="post" class="admin-form admin-form--wide"><input type="hidden" name="action" value="create" />
        <label for="addressee">A quién va dirigida</label><input id="addressee" name="addressee" maxlength="160" required placeholder="Ej.: María y Pablo" />
        <label for="email">Correo de contacto (opcional)</label><input id="email" name="email" type="email" maxlength="254" placeholder="Para llevar el seguimiento; no se envía automáticamente" />
        <label for="guestNames">Personas incluidas, una por línea</label><textarea id="guestNames" name="guestNames" rows="4" required placeholder={'María\nPablo'}></textarea>
        <label for="groupId">Grupo (opcional)</label><select id="groupId" name="groupId"><option value="">Sin grupo</option>{groups.map((group) => <option value={group.id}>{group.name} · {localeName[group.locale]}</option>)}</select>
        <label for="locale">Idioma si no hay grupo</label><select id="locale" name="locale"><option value="es">Español</option><option value="uk">Українська</option></select>
        <label for="personalNote">Mensaje personal en español (opcional)</label><textarea id="personalNote" name="personalNote" rows="3" maxlength="1000"></textarea>
        <label for="personalNoteUk">Mensaje personal en ucraniano (opcional)</label><textarea id="personalNoteUk" name="personalNoteUk" rows="3" maxlength="1000"></textarea>
        <button class="button button--primary" type="submit">Crear invitación y enlace</button>
      </form>
    </section>
    <section id="ajustes" class="admin-section" aria-labelledby="ajustes-title"><div class="admin-section__heading"><div><p class="eyebrow">Control</p><h2 id="ajustes-title">Plazo de confirmación</h2></div></div>
      <form method="post" class="admin-form"><input type="hidden" name="action" value="settings" /><label class="admin-checkbox"><input type="checkbox" name="enabled" value="yes" checked={config.rsvp_enabled} /> Permitir respuestas</label><label for="deadline">Fecha límite (opcional)</label><input type="date" id="deadline" name="deadline" value={config.rsvp_deadline ?? ''} /><button class="button button--primary" type="submit">Guardar ajustes</button></form>
    </section>
  </div>
</BaseLayout>
