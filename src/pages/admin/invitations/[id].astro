---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AdminNav from '../../../components/admin/AdminNav.astro';
import AdminInvitationHeader from '../../../components/admin/AdminInvitationHeader.astro';
import AdminInvitationLink from '../../../components/admin/AdminInvitationLink.astro';
import AdminInvitationPersonalization from '../../../components/admin/AdminInvitationPersonalization.astro';
import AdminInvitationGuests from '../../../components/admin/AdminInvitationGuests.astro';
import AdminInvitationDanger from '../../../components/admin/AdminInvitationDanger.astro';
import { requireAdmin } from '../../../lib/auth.server';
import { sameOrigin } from '../../../lib/security.server';
import { adminDataRevision, invitationById, listGroups, listGuestChoices, invitationToken, updateInvitation, updateInvitationState, addGuest, updateGuest, removeGuest, linkGuests, unlinkGuest, deleteInvitation } from '../../../lib/invitations.server';
import { invitationInput, guestInput, formField, requiredField } from '../../../lib/forms.server';
import { invitationPath } from '../../../lib/i18n';
import { publicInvitationLink } from '../../../lib/invitation-message';
import { env } from '../../../lib/env.server';
export const prerender = false;
if (!await requireAdmin(Astro)) return Astro.redirect('/admin/login', 303);
const id = Astro.params.id ?? '';
if (!/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(id)) return new Response('No hem trobat la invitació', { status: 404 });
let dataRevision = '';
if (Astro.request.method !== 'POST') {
  try { dataRevision = await adminDataRevision('detail', id); } catch { /* The detail remains usable if revision checks fail. */ }
}
let invitation = await invitationById(id);
if (!invitation) return new Response('No hem trobat la invitació', { status: 404 });
const acceptsJson = Astro.request.headers.get('accept') === 'application/json';
const jsonResponse = (payload: object, status = 200) => new Response(JSON.stringify(payload), { status, headers: { 'Content-Type': 'application/json', 'Cache-Control': 'private, no-store' } });
const revisionAfterChange = async () => {
  try { return await adminDataRevision('detail', id); } catch { return undefined; }
};
let error = '';
if (Astro.request.method === 'POST') {
  if (!sameOrigin(Astro)) return acceptsJson ? jsonResponse({ error: 'No s’ha pogut validar la sol·licitud' }, 403) : new Response('No s’ha pogut validar la sol·licitud', { status: 403 });
  const data = await Astro.request.formData();
  try {
    const action = formField(data, 'action');
    if (action === 'edit') await updateInvitation(id, invitationInput(data));
    else if (action === 'delete') {
      if (formField(data, 'confirmName') !== invitation.addressee) throw new Error('Escriu exactament el destinatari per a eliminar la invitació.');
      await deleteInvitation(id);
      if (acceptsJson) return jsonResponse({ redirect: '/admin/gestion?deleted=1' });
      return Astro.redirect('/admin/gestion?deleted=1', 303);
    }
    else if (['sent', 'unsent', 'revoke', 'restore', 'rotate'].includes(action)) await updateInvitationState(id, action as 'sent' | 'unsent' | 'revoke' | 'restore' | 'rotate');
    else if (action === 'addGuest') {
      if (invitation.guests.length >= 20) throw new Error('Una invitació admet fins a 20 persones.');
      await addGuest(id, requiredField(formField(data, 'name'), 160, 'Nom'));
    } else if (action === 'linkGuests') {
      const firstId = formField(data, 'firstGuestId');
      const secondId = formField(data, 'secondGuestId');
      if (![firstId, secondId].every((value) => /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(value))) throw new Error('Selecciona dues persones vàlides.');
      await linkGuests(firstId, secondId, id);
    } else if (action === 'editGuest' || action === 'removeGuest' || action === 'unlinkGuest') {
      const guestId = formField(data, 'guestId');
      if (!invitation.guests.some((guest) => guest.id === guestId)) throw new Error('No hem trobat esta persona.');
      if (action === 'unlinkGuest') await unlinkGuest(guestId, id);
      else if (action === 'removeGuest') {
        if (invitation.guests.length <= 1) throw new Error('La invitació ha d’incloure almenys una persona.');
        await removeGuest(guestId, id);
      } else await updateGuest(guestId, id, guestInput(data));
    } else throw new Error('Acció no vàlida.');
    if (acceptsJson) return jsonResponse({ part: action === 'edit' ? 'edit' : ['sent', 'unsent', 'revoke', 'restore', 'rotate'].includes(action) ? 'state' : 'guests', revision: await revisionAfterChange() });
    return Astro.redirect(`/admin/invitations/${id}?saved=1`, 303);
  } catch (cause) {
    error = cause instanceof Error ? cause.message : 'No hem pogut guardar els canvis.';
    if (acceptsJson) return jsonResponse({ error }, 400);
  }
  invitation = (await invitationById(id))!;
}
const groups = await listGroups();
const choices = await listGuestChoices();
const token = invitationToken(invitation.token_encrypted);
const allowLocal = import.meta.env.DEV || ['localhost', '127.0.0.1', '[::1]'].includes(Astro.url.hostname);
const publicLink = publicInvitationLink(token, invitation.locale, env('PUBLIC_SITE_URL'), allowLocal);
const link = publicLink ?? `${Astro.url.origin}${invitationPath(token, invitation.locale)}`;
---
<BaseLayout title={`${invitation.addressee} · Invitacions`} privatePage>
  <div class="admin-shell admin-shell--detail" data-admin-revision={dataRevision}>
    <AdminInvitationHeader invitation={invitation} />
    <AdminNav active="invitacions" />
    <p class="form-message" data-detail-feedback role="status" hidden></p>
    {error && <p class="form-message form-message--error" role="alert">{error}</p>}
    {Astro.url.searchParams.has('created') && <p class="form-message form-message--success" role="status">{publicLink ? 'Invitació creada. Copia l’enllaç per a compartir-la.' : 'Invitació creada. Configura el domini públic abans de compartir-la.'}</p>}
    {Astro.url.searchParams.has('saved') && <p class="form-message form-message--success" role="status">Canvis guardats.</p>}
    <AdminInvitationLink invitation={invitation} link={link} shareable={Boolean(publicLink)} />
    <AdminInvitationPersonalization invitation={invitation} groups={groups} />
    <AdminInvitationGuests invitation={invitation} choices={choices} />
    <AdminInvitationDanger invitation={invitation} />

  </div>
  <script>
    const shell = document.querySelector<HTMLElement>('.admin-shell--detail');
    const feedback = document.querySelector<HTMLElement>('[data-detail-feedback]');
    const announce = (message: string, error = false) => {
      if (!feedback) return;
      feedback.hidden = false;
      feedback.textContent = message;
      feedback.className = `form-message form-message--${error ? 'error' : 'success'}`;
      feedback.setAttribute('role', error ? 'alert' : 'status');
    };
    const syncBus = (form: HTMLFormElement) => {
      const bus = form.querySelector<HTMLSelectElement>('select[name="bus"]');
      const response = form.querySelector<HTMLSelectElement>('select[name="response"]');
      const route = form.querySelector<HTMLElement>('[data-admin-bus-route]');
      const routeSelect = route?.querySelector<HTMLSelectElement>('select');
      const needsRoute = response?.value === 'yes' && bus?.value === 'yes';
      if (route) route.hidden = !needsRoute;
      if (routeSelect) routeSelect.required = needsRoute;
    };
    const dirtyForms = new WeakSet<HTMLFormElement>();
    let saving = false;
    const markDirty = (event: Event) => {
      const form = (event.target as Element).closest<HTMLFormElement>('form');
      if (form) dirtyForms.add(form);
    };
    shell?.addEventListener('input', markDirty);
    shell?.addEventListener('change', markDirty);
    const refreshFragments = async (part: 'edit' | 'state' | 'guests' | 'all', action?: string, guestId?: string) => {
      const fragmentUrl = new URL(`${location.pathname.replace(/\/$/, '')}/fragmento`, location.origin);
      fragmentUrl.searchParams.set('part', part);
      const fragment = await fetch(fragmentUrl, { cache: 'no-store', headers: { Accept: 'text/html' } });
      if (fragment.redirected && new URL(fragment.url).pathname === '/admin/login') { location.assign(fragment.url); return false; }
      if (fragment.status === 404) { location.assign('/admin/gestion?deleted=1'); return false; }
      if (!fragment.ok || !fragment.headers.get('content-type')?.includes('text/html')) throw new Error('No s’ha pogut actualitzar la invitació.');
      const parsed = new DOMParser().parseFromString(await fragment.text(), 'text/html');
      const incoming = parsed.querySelector<HTMLElement>('[data-detail-fragments]');
      if (!incoming) throw new Error('No s’ha pogut actualitzar la invitació.');
      for (const next of incoming.querySelectorAll<HTMLElement>('[data-detail-part]')) {
        const current = shell?.querySelector<HTMLElement>(`[data-detail-part="${next.dataset.detailPart}"]`);
        if (!current) throw new Error('No s’ha pogut actualitzar la invitació.');
        if (part === 'guests' && action && action !== 'linkGuests' && action !== 'unlinkGuest') {
          const articles = [...current.querySelectorAll<HTMLElement>('[data-guest-id]')];
          const freshArticles = [...next.querySelectorAll<HTMLElement>('[data-guest-id]')];
          const existing = articles.find((article) => article.dataset.guestId === guestId);
          if (action === 'editGuest') {
            const fresh = freshArticles.find((article) => article.dataset.guestId === guestId);
            if (!existing || !fresh) throw new Error('No s’ha pogut actualitzar la persona.');
            existing.replaceWith(fresh);
          } else if (action === 'removeGuest') {
            if (!existing) throw new Error('No s’ha pogut actualitzar la persona.');
            existing.remove();
          } else if (action === 'addGuest') {
            const list = current.querySelector<HTMLElement>('.admin-guests');
            const known = new Set(articles.map((article) => article.dataset.guestId));
            const added = freshArticles.filter((article) => !known.has(article.dataset.guestId));
            if (!list || !added.length) throw new Error('No s’ha pogut actualitzar la persona.');
            list.append(...added);
          }
          const partnerControls = current.querySelector<HTMLElement>('.admin-partners');
          const freshPartnerControls = next.querySelector<HTMLElement>('.admin-partners');
          if (partnerControls && freshPartnerControls && !dirtyForms.has(partnerControls.querySelector('form')!)) partnerControls.replaceWith(freshPartnerControls);
          continue;
        }
        current.replaceWith(next);
      }
      shell?.querySelectorAll<HTMLFormElement>('.admin-guest .admin-form').forEach(syncBus);
      const heading = shell?.querySelector<HTMLElement>('[data-detail-part="header"] h1');
      if (heading) document.title = `${heading.textContent} · Invitacions`;
      return true;
    };
    let lastRevision = shell?.dataset.adminRevision ?? '';
    let checkingRevision = false;
    const checkRevision = async () => {
      if (document.hidden || checkingRevision) return;
      checkingRevision = true;
      try {
        const response = await fetch(`/admin/revision?scope=detail&id=${encodeURIComponent(location.pathname.split('/').pop() ?? '')}`, { cache: 'no-store', headers: { Accept: 'application/json' } });
        if (response.redirected && new URL(response.url).pathname === '/admin/login') { location.assign(response.url); return; }
        if (!response.ok || !response.headers.get('content-type')?.includes('application/json')) return;
        const { revision } = await response.json() as { revision?: string };
        if (!revision) return;
        if (!lastRevision) { lastRevision = revision; return; }
        if (revision === lastRevision) return;
        if (saving || [...(shell?.querySelectorAll<HTMLFormElement>('form') ?? [])].some((form) => dirtyForms.has(form))) {
          announce('Hi ha dades noves. Guarda o descarta els canvis del formulari per a actualitzar la vista.');
          return;
        }
        if (await refreshFragments('all')) lastRevision = revision;
      } catch { /* The next visible poll retries. */ }
      finally { checkingRevision = false; }
    };
    document.addEventListener('visibilitychange', () => { if (!document.hidden) void checkRevision(); });
    window.addEventListener('storage', (event) => { if (event.key === 'wedding.admin.changed' && !document.hidden) void checkRevision(); });
    window.setInterval(() => { void checkRevision(); }, 60000);
    shell?.querySelectorAll<HTMLFormElement>('.admin-guest .admin-form').forEach(syncBus);
    shell?.addEventListener('change', (event) => {
      const field = event.target;
      if (!(field instanceof HTMLSelectElement) || !['bus', 'response'].includes(field.name)) return;
      const form = field.closest<HTMLFormElement>('.admin-guest .admin-form');
      if (form) syncBus(form);
    });
    shell?.addEventListener('submit', async (event) => {
      const form = event.target;
      if (!(form instanceof HTMLFormElement)) return;
      const action = form.querySelector<HTMLInputElement>('input[name="action"]')?.value;
      const guestId = form.querySelector<HTMLInputElement>('input[name="guestId"]')?.value;
      const postedName = form.querySelector<HTMLInputElement>('input[name="name"]')?.value;
      if (!action) return;
      event.preventDefault();
      if (form.dataset.confirm && !window.confirm(form.dataset.confirm)) return;
      if (['linkGuests', 'unlinkGuest'].includes(action) && [...(shell?.querySelectorAll<HTMLFormElement>('form') ?? [])].some((other) => other !== form && dirtyForms.has(other)) && !window.confirm('Hi ha canvis sense guardar en altres formularis. Vols continuar i descartar-los?')) return;
      const button = (event as SubmitEvent).submitter instanceof HTMLButtonElement
        ? (event as SubmitEvent).submitter as HTMLButtonElement
        : form.querySelector<HTMLButtonElement>('[type="submit"]');
      if (!button || button.disabled) return;
      button.disabled = true;
      form.setAttribute('aria-busy', 'true');
      saving = true;
      let saved = false;
      try {
        const response = await fetch(form.getAttribute('action') ?? location.href, {
          method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' }, cache: 'no-store',
        });
        if (response.redirected && new URL(response.url).pathname === '/admin/login') { location.assign(response.url); return; }
        if (!response.headers.get('content-type')?.includes('application/json')) throw new Error('No s’ha pogut guardar els canvis.');
        const result = await response.json() as { error?: string; redirect?: string; part?: 'edit' | 'state' | 'guests'; revision?: string };
        if (!response.ok) throw new Error(result.error ?? 'No s’ha pogut guardar els canvis.');
        saved = true;
        if (result.revision) lastRevision = result.revision;
        try { localStorage.setItem('wedding.admin.changed', String(Date.now())); } catch { /* Storage can be unavailable. */ }
        if (result.redirect) { location.assign(result.redirect); return; }
        if (!result.part) throw new Error('No s’ha pogut actualitzar la invitació.');
        await refreshFragments(result.part, action, guestId);
        const nameInput = form.querySelector<HTMLInputElement>('input[name="name"]');
        if (action === 'addGuest' && nameInput && nameInput.value === postedName) nameInput.value = '';
        if (action !== 'addGuest' || nameInput?.value === '') dirtyForms.delete(form);
        announce('Canvis guardats.');
      } catch (cause) {
        const message = cause instanceof Error ? cause.message : 'No s’ha pogut guardar els canvis.';
        announce(saved ? `Canvis guardats. ${message} Recarrega la pàgina per a veure’ls.` : message, !saved);
      } finally {
        saving = false;
        form.removeAttribute('aria-busy');
        button.disabled = false;
      }
    });
    shell?.addEventListener('click', async (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>('[data-copy-link]');
      if (!button) return;
      const input = shell.querySelector<HTMLInputElement>('#invitation-link');
      const status = shell.querySelector<HTMLElement>('[data-copy-status]');
      if (!input || !status) return;
      try { await navigator.clipboard.writeText(input.value); status.textContent = 'Enllaç copiat.'; }
      catch { input.focus(); input.select(); status.textContent = 'Selecciona l’enllaç i copia’l manualment.'; }
    });
  </script>
</BaseLayout>
