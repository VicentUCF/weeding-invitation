---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdminNav from '../../components/admin/AdminNav.astro';
import AdminShellHeader from '../../components/admin/AdminShellHeader.astro';
import AdminInvitationResults from '../../components/admin/AdminInvitationResults.astro';
import AdminGroupsSection from '../../components/admin/AdminGroupsSection.astro';
import AdminSettingsSection from '../../components/admin/AdminSettingsSection.astro';
import { requireAdmin, signOut } from '../../lib/auth.server';
import { sameOrigin } from '../../lib/security.server';
import { adminDataRevision, listInvitationsPage, invitationById, listGroups, createGroup, updateGroup, settings, createInvitation, saveSettings, ensureValenciaGroup, updateInvitationState, updateManagedInvitation, deleteInvitation } from '../../lib/invitations.server';
import { formField, requiredField, invitationInput } from '../../lib/forms.server';
import { localeName, parseLocale } from '../../lib/i18n';
import { invitationFilters } from '../../lib/admin-management';
import { ADMIN_PAGE_SIZE, paginationForTotal } from '../../lib/pagination';

export const prerender = false;
if (!await requireAdmin(Astro)) return Astro.redirect('/admin/login', 303);
const acceptsJson = Astro.request.headers.get('accept') === 'application/json';
const jsonResponse = (payload: object, status = 200) => new Response(JSON.stringify(payload), { status, headers: { 'Content-Type': 'application/json', 'Cache-Control': 'private, no-store' } });
const revisionAfterChange = async (scope: 'list' | 'groups' | 'settings') => {
  try { return await adminDataRevision(scope); } catch { return undefined; }
};
let error = '';
let submittedName = '';
let submittedGroup = '';
if (Astro.request.method === 'POST') {
  if (!sameOrigin(Astro)) return new Response('No s’ha pogut validar la sol·licitud', { status: 403 });
  const data = await Astro.request.formData();
  try {
    const action = formField(data, 'action');
    if (action === 'logout') { signOut(Astro); return Astro.redirect('/admin/login', 303); }
    if (action === 'create') {
      const name = requiredField(formField(data, 'name'), 160, 'Nom');
      const groupId = formField(data, 'groupId');
      submittedName = name;
      submittedGroup = groupId;
      if (!/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(groupId)) throw new Error('Selecciona un grup vàlid.');
      const id = await createInvitation({ addressee: name, names: [name], groupId, locale: 'es', email: null, personalNote: null, personalNoteUk: null });
      return Astro.redirect(`/admin/invitations/${id}?created=1`, 303);
    }
    if (action === 'delivery') {
      const id = formField(data, 'invitationId');
      if (!/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(id)) throw new Error('La invitació no és vàlida.');
      const sent = formField(data, 'sent') === 'yes';
      await updateInvitationState(id, sent ? 'sent' : 'unsent');
      if (acceptsJson) return jsonResponse({ sent, revision: await revisionAfterChange('list') });
      const next = new URL('/admin/gestion', Astro.url);
      for (const key of ['q', 'status', 'response', 'group', 'page']) {
        const value = Astro.url.searchParams.get(key);
        if (value) next.searchParams.set(key, value);
      }
      next.searchParams.set('sentSaved', '1');
      return Astro.redirect(next.pathname + next.search, 303);
    }
    if (action === 'editInvitation' || action === 'deleteInvitation') {
      const id = formField(data, 'invitationId');
      if (!/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(id)) throw new Error('La invitació no és vàlida.');
      const current = await invitationById(id);
      if (!current) throw new Error('No hem trobat la invitació.');
      if (action === 'editInvitation') {
        const input = invitationInput(data);
        await updateManagedInvitation(id, input);
      } else {
        if (formField(data, 'confirmName') !== current.addressee) throw new Error('Escriu exactament el nom per a eliminar la invitació.');
        await deleteInvitation(id);
      }
      if (acceptsJson) return jsonResponse({ saved: true, revision: await revisionAfterChange('list') });
      const next = new URL('/admin/gestion', Astro.url);
      for (const key of ['q', 'status', 'response', 'group', 'page']) {
        const value = Astro.url.searchParams.get(key);
        if (value) next.searchParams.set(key, value);
      }
      next.searchParams.set(action === 'editInvitation' ? 'invitationSaved' : 'deleted', '1');
      return Astro.redirect(next.pathname + next.search, 303);
    }
    if (action === 'createGroup') {
      const name = requiredField(formField(data, 'name'), 160, 'Nom del grup');
      await createGroup(name, parseLocale(formField(data, 'locale')));
      const position = Math.max(0, (await listGroups()).findIndex((group) => group.name === name));
      if (acceptsJson) return jsonResponse({ page: Math.floor(position / ADMIN_PAGE_SIZE) + 1, revision: await revisionAfterChange('groups') });
      return Astro.redirect(`/admin/gestion?view=grups&page=${Math.floor(position / ADMIN_PAGE_SIZE) + 1}&groupSaved=1`, 303);
    }
    if (action === 'editGroup') {
      const id = formField(data, 'groupId');
      await updateGroup(id, requiredField(formField(data, 'name'), 160, 'Nom del grup'), parseLocale(formField(data, 'locale')));
      const position = Math.max(0, (await listGroups()).findIndex((group) => group.id === id));
      if (acceptsJson) return jsonResponse({ page: Math.floor(position / ADMIN_PAGE_SIZE) + 1, revision: await revisionAfterChange('groups') });
      const next = new URL('/admin/gestion', Astro.url);
      next.searchParams.set('view', 'grups');
      next.searchParams.set('page', String(Math.floor(position / ADMIN_PAGE_SIZE) + 1));
      next.searchParams.set('groupSaved', '1');
      return Astro.redirect(next.pathname + next.search, 303);
    }
    if (action === 'settings') {
      const deadline = formField(data, 'deadline');
      if (deadline && (!/^\d{4}-\d{2}-\d{2}$/.test(deadline) || Number.isNaN(Date.parse(deadline)))) throw new Error('La data límit no és vàlida.');
      await saveSettings({ rsvp_enabled: formField(data, 'enabled') === 'yes', rsvp_deadline: deadline || null });
      if (acceptsJson) return jsonResponse({ saved: true, revision: await revisionAfterChange('settings') });
      return Astro.redirect('/admin/gestion?view=ajustos&saved=1', 303);
    }
    throw new Error('Acció no vàlida.');
  } catch (cause) {
    error = cause instanceof Error ? cause.message : 'No hem pogut guardar els canvis.';
    if (acceptsJson) return jsonResponse({ error }, 400);
  }
}
let groups = [] as Awaited<ReturnType<typeof listGroups>>;
let managementPage: Awaited<ReturnType<typeof listInvitationsPage>> = { ...paginationForTotal(0, Astro.url.searchParams.get('page')), items: [] };
let config: Awaited<ReturnType<typeof settings>> = { rsvp_enabled: true, rsvp_deadline: null };
let dataRevision = '';
const viewParam = Astro.url.searchParams.get('view');
const requestedView = ['invitacions', 'nova', 'grups', 'ajustos'].includes(viewParam ?? '') ? viewParam : 'invitacions';
const revisionScope = requestedView === 'grups' ? 'groups' : requestedView === 'ajustos' ? 'settings' : 'list';
const filters = invitationFilters(Astro.url);
const { search, status: statusFilter, response: responseFilter, group: groupFilter } = filters;
try { dataRevision = await adminDataRevision(revisionScope); } catch { /* The page remains usable if revision checks fail. */ }
try {
  if (requestedView === 'ajustos') config = await settings();
  else {
    if (requestedView === 'grups') groups = await listGroups();
    else [groups, managementPage] = await Promise.all([listGroups(), listInvitationsPage(filters, Astro.url.searchParams.get('page'))]);
    if (!groups.some((group) => group.name === 'Valencia')) {
      await ensureValenciaGroup();
      groups = await listGroups();
    }
  }
} catch { error = 'No podem carregar les dades. Revisa la connexió amb la base de dades.'; }
const defaultGroup = groups.find((group) => group.name === 'Valencia');
const view = !viewParam && error && submittedName ? 'nova' : requestedView;
---
<BaseLayout title="Configuració i gestió · Boda" privatePage clientNavigation>
  <div class="admin-shell" data-admin-revision={dataRevision} data-admin-scope={revisionScope}>
    <AdminShellHeader />
    <AdminNav active={view === 'grups' ? 'grups' : view === 'ajustos' ? 'ajustos' : 'invitacions'} />
    <p class="form-message" data-admin-feedback role="status" hidden></p>
    {error && view !== 'nova' && <p class="form-message form-message--error" role="alert">{error}</p>}
    {Astro.url.searchParams.has('saved') && <p class="form-message form-message--success" role="status">Configuració guardada.</p>}
    {Astro.url.searchParams.has('groupSaved') && <p class="form-message form-message--success" role="status">Grup i idioma guardats.</p>}
    {Astro.url.searchParams.has('deleted') && <p class="form-message form-message--success" role="status">Invitació i respostes eliminades.</p>}
    {Astro.url.searchParams.has('sentSaved') && <p class="form-message form-message--success" role="status">Estat d’enviament guardat.</p>}
    {Astro.url.searchParams.has('invitationSaved') && <p class="form-message form-message--success" role="status">Invitació actualitzada.</p>}
    {(view === 'invitacions' || view === 'nova') && <main class="admin-section" aria-labelledby="existing-title">
      <div class="admin-section__heading"><div><p class="eyebrow">Gestiona</p><h2 id="existing-title">Invitacions</h2></div><div class="admin-section__actions"><a href="/admin/export.csv">Baixa el CSV</a><a class="button button--primary" href="/admin/gestion?view=nova" data-open-invitation>Afig una invitació</a></div></div>
      <form method="get" action="/admin/gestion" class="admin-management-filters" role="search">
        <label for="invitation-q">Busca per nom o correu<input id="invitation-q" name="q" type="search" value={search} /></label>
        <label for="invitation-status">Enviament<select id="invitation-status" name="status"><option value="all" selected={statusFilter === 'all'}>Tots</option><option value="unsent" selected={statusFilter === 'unsent'}>Sense enviar</option><option value="sent" selected={statusFilter === 'sent'}>Enviades</option><option value="revoked" selected={statusFilter === 'revoked'}>Revocades</option></select></label>
        <label for="invitation-response">Assistència<select id="invitation-response" name="response"><option value="all" selected={responseFilter === 'all'}>Totes</option><option value="yes" selected={responseFilter === 'yes'}>Assistiran</option><option value="no" selected={responseFilter === 'no'}>No assistiran</option><option value="pending" selected={responseFilter === 'pending'}>Pendents</option></select></label>
        <label for="invitation-group">Grup<select id="invitation-group" name="group"><option value="all" selected={groupFilter === 'all'}>Tots</option><option value="none" selected={groupFilter === 'none'}>Sense grup</option>{groups.map((group) => <option value={group.id} selected={groupFilter === group.id}>{group.name}</option>)}</select></label>
        <button class="button" type="submit">Filtra</button>
      </form>
      <AdminInvitationResults page={managementPage} filters={filters} />
      <p class="admin-copy-status" data-copy-status role="status" aria-live="polite"></p>
    </main>}
    {(view === 'invitacions' || view === 'nova') && <dialog class="admin-dialog" aria-labelledby="new-title" open={view === 'nova'} data-invitation-dialog>
      <div class="admin-dialog__heading"><div><p class="eyebrow">Prepara</p><h2 id="new-title">Nova invitació</h2></div><a href="/admin/gestion" data-close-invitation aria-label="Tanca el formulari">Tanca ×</a></div>
      {error && view === 'nova' && <p class="form-message form-message--error" role="alert">{error}</p>}
      <form method="post" action="/admin/gestion?view=nova" class="admin-form admin-form--wide" data-astro-reload><input type="hidden" name="action" value="create" />
        <label for="name">Nom</label><input id="name" name="name" maxlength="160" required autocomplete="name" value={submittedName} placeholder="Per exemple: Maria" />
        <label for="groupId">Grup</label><select id="groupId" name="groupId" required>{groups.map((group) => <option value={group.id} selected={group.id === (submittedGroup || defaultGroup?.id)}>{group.name} · {localeName[group.locale]}</option>)}</select>
        <button class="button button--primary" type="submit">Crea la invitació i l’enllaç</button>
      </form>
    </dialog>}
    {(view === 'invitacions' || view === 'nova') && <dialog class="admin-dialog" aria-labelledby="view-title" data-action-dialog="view">
      <div class="admin-dialog__heading"><div><p class="eyebrow">Persones convidades</p><h2 id="view-title">Persones de <span data-view-name></span></h2></div><button type="button" class="admin-link" data-close-modal>Tanca ×</button></div>
      <p data-no-responses>Encara no hi ha persones convidades.</p>
      <ul class="admin-response-list" data-response-list></ul>
    </dialog>}
    {(view === 'invitacions' || view === 'nova') && <dialog class="admin-dialog" aria-labelledby="edit-title" data-action-dialog="edit">
      <div class="admin-dialog__heading"><div><p class="eyebrow">Modifica</p><h2 id="edit-title">Edita la invitació</h2></div><button type="button" class="admin-link" data-close-modal>Tanca ×</button></div>
      <form method="post" action={Astro.url.pathname + Astro.url.search} class="admin-form"><input type="hidden" name="action" value="editInvitation" /><input type="hidden" name="invitationId" data-edit-id />
        <label for="edit-name">Nom de la invitació</label><input id="edit-name" name="addressee" maxlength="160" required />
        <label for="edit-group">Grup</label><select id="edit-group" name="groupId"><option value="">Sense grup</option>{groups.map((group) => <option value={group.id}>{group.name} · {localeName[group.locale]}</option>)}</select>
        <label for="edit-email">Correu de contacte (opcional)</label><input id="edit-email" name="email" type="email" maxlength="254" />
        <label for="edit-note">Missatge personal en valencià (opcional)</label><textarea id="edit-note" name="personalNote" rows="3" maxlength="1000"></textarea>
        <label for="edit-note-uk">Missatge personal en ucraïnés (opcional)</label><textarea id="edit-note-uk" name="personalNoteUk" rows="3" maxlength="1000"></textarea>
        <button class="button button--primary" type="submit">Guarda els canvis</button>
      </form>
      <a class="admin-dialog__detail-link" data-edit-detail>Edita les persones, respostes i l’enllaç →</a>
    </dialog>}
    {(view === 'invitacions' || view === 'nova') && <dialog class="admin-dialog admin-dialog--danger" aria-labelledby="delete-title" data-action-dialog="delete"><div class="admin-dialog__heading"><div><p class="eyebrow">Elimina definitivament</p><h2 id="delete-title">Elimina la invitació</h2></div><button type="button" class="admin-link" data-close-modal>Tanca ×</button></div><p>S’eliminaran l’enllaç i totes les respostes. Esta acció no es pot desfer.</p><form method="post" action={Astro.url.pathname + Astro.url.search} class="admin-form"><input type="hidden" name="action" value="deleteInvitation" /><input type="hidden" name="invitationId" data-delete-id /><label for="delete-name" data-delete-label></label><input id="delete-name" name="confirmName" autocomplete="off" required /><button class="button" type="submit">Elimina definitivament</button></form></dialog>}
    {view === 'grups' && <AdminGroupsSection groups={groups} rawPage={Astro.url.searchParams.get('page')} />}
    {view === 'ajustos' && <AdminSettingsSection config={config} />}
  </div>
  <script>
    let mountedShell: HTMLElement | null = null;
    let disposeManagement: (() => void) | undefined;
    const mountManagement = () => {
    const nextShell = document.querySelector<HTMLElement>('.admin-shell[data-admin-scope]');
    if (nextShell === mountedShell) return;
    disposeManagement?.();
    mountedShell = nextShell;
    if (!nextShell) return;
    const lifecycle = new AbortController();
    const { signal } = lifecycle;
    const actionDialogs = {
      view: document.querySelector<HTMLDialogElement>('[data-action-dialog="view"]'),
      edit: document.querySelector<HTMLDialogElement>('[data-action-dialog="edit"]'),
      delete: document.querySelector<HTMLDialogElement>('[data-action-dialog="delete"]'),
    };
    document.addEventListener('click', (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>('[data-open-modal]');
      if (!button) return;
      const row = button.closest<HTMLTableRowElement>('tr[data-invitation-id]');
      const kind = button.dataset.openModal as keyof typeof actionDialogs;
      const dialog = actionDialogs[kind];
      if (!row || !dialog) return;
      const { invitationId: id = '', invitationName: name = '', invitationGroup: groupId = '' } = row.dataset;
      if (kind === 'view') {
        const heading = dialog.querySelector<HTMLElement>('[data-view-name]');
        const list = dialog.querySelector<HTMLUListElement>('[data-response-list]');
        const empty = dialog.querySelector<HTMLElement>('[data-no-responses]');
        if (heading) heading.textContent = name;
        if (list) {
          list.replaceChildren();
          type Answer = { name: string; response: 'pending' | 'yes' | 'no'; allergies: string; observations: string; busSeat: boolean | null; busRoute: string | null };
          const answers = JSON.parse(row.dataset.invitationResponses ?? '[]') as Answer[];
          if (empty) empty.hidden = answers.length > 0;
          const addDetail = (parent: HTMLElement, label: string, value: string) => {
            const paragraph = document.createElement('p');
            const title = document.createElement('strong');
            title.textContent = `${label}: `;
            paragraph.append(title, document.createTextNode(value));
            parent.append(paragraph);
          };
          for (const answer of answers) {
            const item = document.createElement('li');
            const guestName = document.createElement('h3');
            guestName.textContent = answer.name;
            item.append(guestName);
            addDetail(item, 'Assistència', answer.response === 'yes' ? 'Assistirà' : answer.response === 'no' ? 'No assistirà' : 'Pendent');
            if (answer.response === 'yes') {
              if (answer.allergies) addDetail(item, 'Al·lèrgies', answer.allergies);
              if (answer.observations) addDetail(item, 'Observacions', answer.observations);
              const route = answer.busRoute === 'outbound' ? 'Només anada' : answer.busRoute === 'return' ? 'Només tornada' : answer.busRoute === 'both' ? 'Anada i tornada' : 'Sense trajecte';
              addDetail(item, 'Autobús', answer.busSeat === true ? route : answer.busSeat === false ? 'No' : 'Sense resposta');
            }
            list.append(item);
          }
        }
      } else if (kind === 'edit') {
        const idInput = dialog.querySelector<HTMLInputElement>('[data-edit-id]');
        const nameInput = dialog.querySelector<HTMLInputElement>('#edit-name');
        const groupSelect = dialog.querySelector<HTMLSelectElement>('#edit-group');
        const emailInput = dialog.querySelector<HTMLInputElement>('#edit-email');
        const noteInput = dialog.querySelector<HTMLTextAreaElement>('#edit-note');
        const noteUkInput = dialog.querySelector<HTMLTextAreaElement>('#edit-note-uk');
        const detail = dialog.querySelector<HTMLAnchorElement>('[data-edit-detail]');
        if (idInput) idInput.value = id;
        if (nameInput) nameInput.value = name;
        if (groupSelect) groupSelect.value = groupId;
        if (emailInput) emailInput.value = row.dataset.invitationEmail ?? '';
        if (noteInput) noteInput.value = row.dataset.invitationNote ?? '';
        if (noteUkInput) noteUkInput.value = row.dataset.invitationNoteUk ?? '';
        if (detail) detail.href = `/admin/invitations/${id}`;
      } else {
        const idInput = dialog.querySelector<HTMLInputElement>('[data-delete-id]');
        const label = dialog.querySelector<HTMLLabelElement>('[data-delete-label]');
        const confirmation = dialog.querySelector<HTMLInputElement>('#delete-name');
        if (idInput) idInput.value = id;
        if (label) label.textContent = `Escriu «${name}» per a confirmar`;
        if (confirmation) confirmation.value = '';
      }
      dialog.showModal();
    }, { signal });
    document.querySelectorAll<HTMLButtonElement>('[data-close-modal]').forEach((button) => button.addEventListener('click', () => button.closest('dialog')?.close()));
    const results = document.querySelector<HTMLElement>('[data-management-results]');
    const filters = document.querySelector<HTMLFormElement>('.admin-management-filters');
    const status = document.querySelector<HTMLElement>('[data-copy-status]');
    const feedback = document.querySelector<HTMLElement>('[data-admin-feedback]');
    const shell = nextShell;
    const announce = (message: string, error = false) => {
      if (!feedback) return;
      feedback.hidden = false;
      feedback.textContent = message;
      feedback.className = `form-message form-message--${error ? 'error' : 'success'}`;
      feedback.setAttribute('role', error ? 'alert' : 'status');
    };
    const pageCache = new Map<string, { html: string; savedAt: number }>();
    const cacheKey = (url: URL) => url.pathname + url.search;
    const remember = (url: URL, html: string) => {
      pageCache.delete(cacheKey(url));
      pageCache.set(cacheKey(url), { html, savedAt: Date.now() });
      if (pageCache.size > 8) pageCache.delete(pageCache.keys().next().value!);
    };
    if (results) remember(new URL(location.href), results.innerHTML);
    let request: AbortController | undefined;
    const navigateResults = async (url: URL, mode: 'push' | 'pop', fresh = false, withGroups = false) => {
      if (!results || !filters) return false;
      request?.abort();
      const current = request = new AbortController();
      results.setAttribute('aria-busy', 'true');
      try {
        const cached = !fresh && pageCache.get(cacheKey(url));
        let html = cached && Date.now() - cached.savedAt < 15000 ? cached.html : '';
        let groupOptions: HTMLTemplateElement | null = null;
        if (!html) {
          const partialUrl = new URL('/admin/gestion/resultados', url);
          partialUrl.search = url.search;
          if (withGroups) partialUrl.searchParams.set('groups', '1');
          const response = await fetch(partialUrl, { signal: current.signal, cache: 'no-store', headers: { Accept: 'text/html' } });
          if (response.redirected && new URL(response.url).pathname === '/admin/login') { location.assign(response.url); return; }
          if (!response.ok || !response.headers.get('content-type')?.includes('text/html')) throw new Error('Invalid response');
          const parsed = new DOMParser().parseFromString(await response.text(), 'text/html');
          const nextResults = parsed.querySelector<HTMLElement>('[data-management-results]');
          if (!nextResults) throw new Error('Missing invitation list');
          if (withGroups) {
            groupOptions = parsed.querySelector<HTMLTemplateElement>('[data-management-group-options]');
            if (!groupOptions) throw new Error('Missing group options');
          }
          html = nextResults.innerHTML;
          remember(url, html);
        }
        if (current.signal.aborted) return;
        const paginationFocused = document.activeElement?.closest('.admin-pagination');
        results.innerHTML = html;
        if (groupOptions) {
          for (const [target, source] of [
            [filters.querySelector<HTMLSelectElement>('[name="group"]'), groupOptions.content.querySelector<HTMLSelectElement>('[data-filter-options]')],
            [document.querySelector<HTMLSelectElement>('#edit-group'), groupOptions.content.querySelector<HTMLSelectElement>('[data-edit-options]')],
            [document.querySelector<HTMLSelectElement>('#groupId'), groupOptions.content.querySelector<HTMLSelectElement>('[data-create-options]')],
          ] as const) {
            if (!target || !source) continue;
            const signature = (select: HTMLSelectElement) => [...select.options].map((option) => `${option.value}:${option.textContent}`).join('|');
            if (signature(target) === signature(source)) continue;
            const selected = target.value;
            target.replaceChildren(...[...source.options].map((option) => option.cloneNode(true)));
            if ([...target.options].some((option) => option.value === selected)) target.value = selected;
          }
        }
        results.removeAttribute('aria-busy');
        if (mode === 'push') history.pushState(null, '', url);
        for (const name of ['q', 'status', 'response', 'group']) {
          const field = filters.elements.namedItem(name);
          if (field instanceof HTMLInputElement || field instanceof HTMLSelectElement) field.value = url.searchParams.get(name) ?? (name === 'q' ? '' : 'all');
        }
        for (const form of document.querySelectorAll<HTMLFormElement>('[data-action-dialog] form')) form.setAttribute('action', url.href);
        if (status) status.textContent = 'Llista actualitzada.';
        if (mode === 'push' && paginationFocused) {
          const selectedPage = results.querySelector<HTMLElement>('.admin-pagination [aria-current="page"]');
          selectedPage?.focus({ preventScroll: true });
        }
        return true;
      } catch (error) {
        if (current.signal.aborted) return false;
        results.removeAttribute('aria-busy');
        if (status) status.textContent = 'No s’ha pogut carregar la llista. Torna a provar-ho.';
        return false;
      }
    };
    const postForm = async (form: HTMLFormElement) => {
      const response = await fetch(form.getAttribute('action') ?? location.href, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' }, cache: 'no-store' });
      if (response.redirected && new URL(response.url).pathname === '/admin/login') { location.assign(response.url); throw new Error('La sessió ha caducat.'); }
      if (!response.headers.get('content-type')?.includes('application/json')) throw new Error('No s’ha pogut guardar els canvis.');
      const result = await response.json() as { error?: string; page?: number; revision?: string };
      if (!response.ok) throw new Error(result.error ?? 'No s’ha pogut guardar els canvis.');
      return result;
    };
    const sectionCache = new Map<string, { html: string; savedAt: number }>();
    const notifyDataChanged = () => {
      pageCache.clear();
      sectionCache.clear();
      try { localStorage.setItem('wedding.admin.changed', String(Date.now())); } catch { /* Storage can be unavailable. */ }
    };
    const sectionKey = (kind: 'groups' | 'settings', url: URL) => `${kind}:${cacheKey(url)}`;
    const currentKind = document.querySelector('[data-admin-groups]') ? 'groups' : document.querySelector('[data-admin-settings]') ? 'settings' : null;
    if (currentKind) {
      const main = document.querySelector<HTMLElement>(currentKind === 'groups' ? '[data-admin-groups]' : '[data-admin-settings]');
      if (main) sectionCache.set(sectionKey(currentKind, new URL(location.href)), { html: main.outerHTML, savedAt: Date.now() });
    }
    let sectionRequest: AbortController | undefined;
    const navigateSection = async (kind: 'groups' | 'settings', url: URL, mode: 'push' | 'pop' | 'replace', fresh = false) => {
      const selector = kind === 'groups' ? '[data-admin-groups]' : '[data-admin-settings]';
      const current = document.querySelector<HTMLElement>(selector);
      if (!current) return false;
      sectionRequest?.abort();
      const controller = sectionRequest = new AbortController();
      current.setAttribute('aria-busy', 'true');
      try {
        const cached = !fresh && sectionCache.get(sectionKey(kind, url));
        let html = cached && Date.now() - cached.savedAt < 15000 ? cached.html : '';
        if (!html) {
          const endpoint = new URL(kind === 'groups' ? '/admin/gestion/grupos' : '/admin/gestion/ajustes', url);
          endpoint.search = url.search;
          const response = await fetch(endpoint, { signal: controller.signal, cache: 'no-store', headers: { Accept: 'text/html' } });
          if (response.redirected && new URL(response.url).pathname === '/admin/login') { location.assign(response.url); return false; }
          if (!response.ok || !response.headers.get('content-type')?.includes('text/html')) throw new Error('No s’ha pogut actualitzar la secció.');
          const parsed = new DOMParser().parseFromString(await response.text(), 'text/html');
          const next = parsed.querySelector<HTMLElement>(selector);
          if (!next) throw new Error('No s’ha pogut actualitzar la secció.');
          html = next.outerHTML;
          sectionCache.set(sectionKey(kind, url), { html, savedAt: Date.now() });
        }
        if (controller.signal.aborted) return false;
        const focusedPagination = document.activeElement?.closest('.admin-pagination');
        const next = new DOMParser().parseFromString(html, 'text/html').querySelector<HTMLElement>(selector);
        if (!next) throw new Error('No s’ha pogut actualitzar la secció.');
        current.replaceWith(next);
        if (mode === 'push') history.pushState(null, '', url);
        if (mode === 'replace') history.replaceState(null, '', url);
        if (mode === 'push' && focusedPagination) next.querySelector<HTMLElement>('.admin-pagination [aria-current="page"]')?.focus({ preventScroll: true });
        return true;
      } catch {
        if (controller.signal.aborted) return false;
        current.removeAttribute('aria-busy');
        announce('No s’ha pogut actualitzar la secció. Torna a provar-ho.', true);
        return false;
      }
    };
    const dirtyForms = new WeakSet<HTMLFormElement>();
    const markDirty = (event: Event) => {
      const field = event.target;
      if (!(field instanceof HTMLInputElement || field instanceof HTMLSelectElement || field instanceof HTMLTextAreaElement)) return;
      if (!field.closest('[data-admin-groups], [data-admin-settings]')) return;
      const form = field.form;
      if (form) dirtyForms.add(form);
    };
    shell?.addEventListener('input', markDirty);
    shell?.addEventListener('change', markDirty);
    const hasPendingEdits = () => {
      if (document.querySelector('dialog[open]')) return true;
      if (document.querySelector('[data-admin-groups] form[aria-busy="true"], [data-admin-settings] form[aria-busy="true"]')) return true;
      if ([...document.querySelectorAll<HTMLFormElement>('[data-admin-groups] form, [data-admin-settings] form')].some((form) => dirtyForms.has(form))) return true;
      if (filters) {
        const url = new URL(location.href);
        for (const [name, value] of new FormData(filters)) {
          if (String(value) !== (url.searchParams.get(name) ?? (name === 'q' ? '' : 'all'))) return true;
        }
      }
      return false;
    };
    const refreshActive = async () => {
      if (hasPendingEdits()) {
        announce('Hi ha dades noves. Guarda o descarta els canvis del formulari per a actualitzar la vista.');
        return false;
      }
      const url = new URL(location.href);
      if (results) return navigateResults(url, 'pop', true, true);
      if (document.querySelector('[data-admin-groups]')) return navigateSection('groups', url, 'pop', true);
      if (document.querySelector('[data-admin-settings]')) return navigateSection('settings', url, 'pop', true);
      return false;
    };
    let lastRevision = shell?.dataset.adminRevision ?? '';
    let checkingRevision = false;
    const checkRevision = async () => {
      if (document.hidden || checkingRevision) return;
      checkingRevision = true;
      try {
        const response = await fetch(`/admin/revision?scope=${shell?.dataset.adminScope ?? 'list'}`, { cache: 'no-store', headers: { Accept: 'application/json' } });
        if (response.redirected && new URL(response.url).pathname === '/admin/login') { location.assign(response.url); return; }
        if (!response.ok || !response.headers.get('content-type')?.includes('application/json')) return;
        const { revision } = await response.json() as { revision?: string };
        if (!revision) return;
        if (!lastRevision) { lastRevision = revision; return; }
        if (revision === lastRevision) return;
        pageCache.clear();
        sectionCache.clear();
        if (await refreshActive()) lastRevision = revision;
      } catch { /* The next visible poll retries. */ }
      finally { checkingRevision = false; }
    };
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) { pageCache.clear(); sectionCache.clear(); void checkRevision(); }
    }, { signal });
    window.addEventListener('storage', (event) => {
      if (event.key !== 'wedding.admin.changed') return;
      pageCache.clear();
      sectionCache.clear();
      if (!document.hidden) void checkRevision();
    }, { signal });
    const revisionPoll = window.setInterval(() => { void checkRevision(); }, 60000);
    shell?.addEventListener('submit', async (event) => {
      const form = event.target;
      if (!(form instanceof HTMLFormElement) || !form.closest('[data-admin-groups], [data-admin-settings]')) return;
      event.preventDefault();
      const kind = form.closest('[data-admin-groups]') ? 'groups' : 'settings';
      const submitter = (event as SubmitEvent).submitter;
      if (!(submitter instanceof HTMLButtonElement) || submitter.disabled) return;
      submitter.disabled = true;
      form.setAttribute('aria-busy', 'true');
      try {
        const result = await postForm(form);
        if (result.revision) lastRevision = result.revision;
        notifyDataChanged();
        const url = new URL(location.href);
        if (kind === 'groups') url.searchParams.set('page', String(result.page ?? 1));
        const refreshed = await navigateSection(kind, url, 'replace', true);
        announce(refreshed ? kind === 'groups' ? 'Grup i idioma guardats.' : 'Configuració guardada.' : 'Canvis guardats. Torna a carregar la secció per a veure’ls.');
      } catch (cause) {
        announce(cause instanceof Error ? cause.message : 'No s’ha pogut guardar els canvis.', true);
      } finally {
        form.removeAttribute('aria-busy');
        submitter.disabled = false;
      }
    });
    shell?.addEventListener('click', (event) => {
      const link = (event.target as Element).closest<HTMLAnchorElement>('[data-admin-groups] .admin-pagination a[href]');
      if (!link || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      navigateSection('groups', new URL(link.href), 'push');
    });
    document.querySelectorAll<HTMLFormElement>('[data-action-dialog] form').forEach((form) => form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const dialog = form.closest<HTMLDialogElement>('dialog');
      const submit = form.querySelector<HTMLButtonElement>('[type="submit"]');
      if (!dialog || !submit || submit.disabled) return;
      dialog.querySelector('[data-action-error]')?.remove();
      submit.disabled = true;
      try {
        const result = await postForm(form);
        if (result.revision) lastRevision = result.revision;
        notifyDataChanged();
        const refreshed = await navigateResults(new URL(location.href), 'pop', true);
        dialog.close();
        if (status) status.textContent = refreshed ? 'Canvis guardats.' : 'Canvis guardats. Torna a carregar la llista per a veure’ls.';
      } catch (cause) {
        const message = document.createElement('p');
        message.className = 'form-message form-message--error';
        message.dataset.actionError = '';
        message.setAttribute('role', 'alert');
        message.textContent = cause instanceof Error ? cause.message : 'No s’ha pogut guardar els canvis.';
        form.before(message);
      } finally { submit.disabled = false; }
    }));
    filters?.addEventListener('submit', (event) => {
      event.preventDefault();
      const url = new URL(filters.action);
      const params = new URLSearchParams();
      for (const [name, value] of new FormData(filters)) params.set(name, String(value));
      url.search = params.toString();
      navigateResults(url, 'push');
    });
    results?.addEventListener('click', (event) => {
      const link = (event.target as Element).closest<HTMLAnchorElement>('.admin-pagination a[href]');
      if (!link || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      navigateResults(new URL(link.href), 'push');
    });
    window.addEventListener('popstate', () => {
      const url = new URL(location.href);
      if (url.pathname !== '/admin/gestion') return;
      if (url.searchParams.get('view') === 'grups' && document.querySelector('[data-admin-groups]')) { navigateSection('groups', url, 'pop'); return; }
      if (url.searchParams.get('view') === 'ajustos' && document.querySelector('[data-admin-settings]')) { navigateSection('settings', url, 'pop'); return; }
      if (!['grups', 'ajustos'].includes(url.searchParams.get('view') ?? '') && results) navigateResults(url, 'pop');
    }, { signal });
    results?.addEventListener('change', async (event) => {
      const checkbox = event.target;
      if (!(checkbox instanceof HTMLInputElement) || checkbox.name !== 'sent') return;
      const form = checkbox.closest<HTMLFormElement>('.admin-delivery-form');
      if (!form) return;
      const label = form.querySelector<HTMLElement>('.admin-delivery-check span');
      checkbox.disabled = true;
      try {
        const data = new FormData(form);
        if (checkbox.checked) data.set('sent', 'yes');
        else data.delete('sent');
        const response = await fetch(form.getAttribute('action') ?? location.href, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
        if (response.redirected && new URL(response.url).pathname === '/admin/login') { location.assign(response.url); return; }
        if (!response.ok || !response.headers.get('content-type')?.includes('application/json')) throw new Error('Invalid response');
        const saved = await response.json() as { sent: boolean; revision?: string };
        checkbox.checked = saved.sent;
        if (saved.revision) lastRevision = saved.revision;
        if (label) label.textContent = saved.sent ? 'Enviada' : 'Sense enviar';
        notifyDataChanged();
        if (status) status.textContent = 'Estat d’enviament guardat.';
        if (new URL(location.href).searchParams.get('status') !== 'all' && new URL(location.href).searchParams.has('status')) {
          await navigateResults(new URL(location.href), 'pop', true);
        } else if (results) remember(new URL(location.href), results.innerHTML);
      } catch {
        checkbox.checked = !checkbox.checked;
        if (status) status.textContent = 'No s’ha pogut guardar l’estat. Torna a provar-ho.';
      } finally { checkbox.disabled = false; }
    });
    const dialog = document.querySelector<HTMLDialogElement>('[data-invitation-dialog]');
    if (dialog && typeof dialog.showModal === 'function') {
      if (dialog.hasAttribute('open')) { dialog.removeAttribute('open'); dialog.showModal(); }
      document.querySelector<HTMLAnchorElement>('[data-open-invitation]')?.addEventListener('click', (event) => {
        event.preventDefault();
        dialog.showModal();
        dialog.querySelector<HTMLInputElement>('[name="name"]')?.focus();
      });
      dialog.querySelector<HTMLAnchorElement>('[data-close-invitation]')?.addEventListener('click', (event) => {
        event.preventDefault();
        dialog.close();
      });
      dialog.addEventListener('close', () => {
        if (new URLSearchParams(location.search).get('view') === 'nova') history.replaceState(null, '', '/admin/gestion');
      });
    }
    results?.addEventListener('click', async (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>('[data-copy-message]');
      if (!button) return;
      const message = button.dataset.copyMessage;
      if (!message || !status) return;
      try { await navigator.clipboard.writeText(message); const label = button.querySelector<HTMLElement>('[data-copy-label]'); if (label) label.textContent = 'Missatge copiat'; status.textContent = 'Missatge amb enllaç copiat.'; }
      catch { window.prompt('Copia este missatge:', message); status.textContent = 'Copia el missatge del quadre de diàleg.'; }
    });
    disposeManagement = () => {
      lifecycle.abort();
      window.clearInterval(revisionPoll);
      request?.abort();
      sectionRequest?.abort();
    };
    };
    document.addEventListener('astro:page-load', mountManagement);
    mountManagement();
  </script>
</BaseLayout>
