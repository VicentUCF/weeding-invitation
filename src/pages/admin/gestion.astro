---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdminIcon from '../../components/admin/AdminIcon.astro';
import AdminNav from '../../components/admin/AdminNav.astro';
import AdminPagination from '../../components/admin/AdminPagination.astro';
import { invitationMessage } from '../../lib/invitation-message';
import { requireAdmin, signOut } from '../../lib/auth.server';
import { sameOrigin } from '../../lib/security.server';
import { listInvitations, listGroups, createGroup, updateGroup, settings, createInvitation, saveSettings, ensureValenciaGroup, invitationToken, updateInvitationState, updateManagedInvitation, deleteInvitation } from '../../lib/invitations.server';
import { formField, requiredField, invitationInput } from '../../lib/forms.server';
import { invitationPath, localeName, parseLocale } from '../../lib/i18n';
import { ADMIN_PAGE_SIZE, paginateItems } from '../../lib/pagination';

export const prerender = false;
if (!await requireAdmin(Astro)) return Astro.redirect('/admin/login', 303);
let error = '';
let submittedName = '';
let submittedGroup = '';
if (Astro.request.method === 'POST') {
  if (!sameOrigin(Astro)) return new Response('No s’ha pogut validar la sol·licitud', { status: 403 });
  const data = await Astro.request.formData();
  try {
    const action = formField(data, 'action');
    if (action === 'logout') { signOut(Astro); return Astro.redirect('/admin/login', 303); }
    if (action === 'create') {
      const name = requiredField(formField(data, 'name'), 160, 'Nom');
      const groupId = formField(data, 'groupId');
      submittedName = name;
      submittedGroup = groupId;
      if (!/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(groupId)) throw new Error('Selecciona un grup vàlid.');
      const id = await createInvitation({ addressee: name, names: [name], groupId, locale: 'es', email: null, personalNote: null, personalNoteUk: null });
      return Astro.redirect(`/admin/invitations/${id}?created=1`, 303);
    }
    if (action === 'delivery') {
      const id = formField(data, 'invitationId');
      if (!/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(id)) throw new Error('La invitació no és vàlida.');
      await updateInvitationState(id, formField(data, 'sent') === 'yes' ? 'sent' : 'unsent');
      const next = new URL('/admin/gestion', Astro.url);
      for (const key of ['q', 'status', 'response', 'group', 'page']) {
        const value = Astro.url.searchParams.get(key);
        if (value) next.searchParams.set(key, value);
      }
      next.searchParams.set('sentSaved', '1');
      return Astro.redirect(next.pathname + next.search, 303);
    }
    if (action === 'editInvitation' || action === 'deleteInvitation') {
      const id = formField(data, 'invitationId');
      if (!/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(id)) throw new Error('La invitació no és vàlida.');
      const current = (await listInvitations()).find((invitation) => invitation.id === id);
      if (!current) throw new Error('No hem trobat la invitació.');
      if (action === 'editInvitation') {
        const input = invitationInput(data);
        await updateManagedInvitation(id, input);
      } else {
        if (formField(data, 'confirmName') !== current.addressee) throw new Error('Escriu exactament el nom per a eliminar la invitació.');
        await deleteInvitation(id);
      }
      const next = new URL('/admin/gestion', Astro.url);
      for (const key of ['q', 'status', 'response', 'group', 'page']) {
        const value = Astro.url.searchParams.get(key);
        if (value) next.searchParams.set(key, value);
      }
      next.searchParams.set(action === 'editInvitation' ? 'invitationSaved' : 'deleted', '1');
      return Astro.redirect(next.pathname + next.search, 303);
    }
    if (action === 'createGroup') {
      const name = requiredField(formField(data, 'name'), 160, 'Nom del grup');
      await createGroup(name, parseLocale(formField(data, 'locale')));
      const position = Math.max(0, (await listGroups()).findIndex((group) => group.name === name));
      return Astro.redirect(`/admin/gestion?view=grups&page=${Math.floor(position / ADMIN_PAGE_SIZE) + 1}&groupSaved=1`, 303);
    }
    if (action === 'editGroup') {
      const id = formField(data, 'groupId');
      await updateGroup(id, requiredField(formField(data, 'name'), 160, 'Nom del grup'), parseLocale(formField(data, 'locale')));
      const position = Math.max(0, (await listGroups()).findIndex((group) => group.id === id));
      const next = new URL('/admin/gestion', Astro.url);
      next.searchParams.set('view', 'grups');
      next.searchParams.set('page', String(Math.floor(position / ADMIN_PAGE_SIZE) + 1));
      next.searchParams.set('groupSaved', '1');
      return Astro.redirect(next.pathname + next.search, 303);
    }
    if (action === 'settings') {
      const deadline = formField(data, 'deadline');
      if (deadline && (!/^\d{4}-\d{2}-\d{2}$/.test(deadline) || Number.isNaN(Date.parse(deadline)))) throw new Error('La data límit no és vàlida.');
      await saveSettings({ rsvp_enabled: formField(data, 'enabled') === 'yes', rsvp_deadline: deadline || null });
      return Astro.redirect('/admin/gestion?view=ajustos&saved=1', 303);
    }
    throw new Error('Acció no vàlida.');
  } catch (cause) { error = cause instanceof Error ? cause.message : 'No hem pogut guardar els canvis.'; }
}
let groups = [] as Awaited<ReturnType<typeof listGroups>>;
let invitations = [] as Awaited<ReturnType<typeof listInvitations>>;
let config: Awaited<ReturnType<typeof settings>> = { rsvp_enabled: true, rsvp_deadline: null };
try {
  await ensureValenciaGroup();
  [groups, config, invitations] = await Promise.all([listGroups(), settings(), listInvitations()]);
} catch { error = 'No podem carregar les dades. Revisa la connexió amb la base de dades.'; }
const defaultGroup = groups.find((group) => group.name === 'Valencia');
const viewParam = Astro.url.searchParams.get('view');
const view = ['invitacions', 'nova', 'grups', 'ajustos'].includes(viewParam ?? '') ? viewParam : error && submittedName ? 'nova' : 'invitacions';
const search = Astro.url.searchParams.get('q')?.trim() ?? '';
const statusFilter = Astro.url.searchParams.get('status') ?? 'all';
const responseParam = Astro.url.searchParams.get('response');
const responseFilter = responseParam && ['yes', 'no', 'pending'].includes(responseParam) ? responseParam : 'all';
const responseFilterNote = responseFilter === 'yes' ? 'amb almenys una persona que assistirà' : responseFilter === 'no' ? 'amb almenys una persona que no assistirà' : responseFilter === 'pending' ? 'amb almenys una persona pendent de resposta' : '';
const groupFilter = Astro.url.searchParams.get('group') ?? 'all';
const filteredInvitations = invitations.filter((invitation) => {
  const text = [invitation.addressee, invitation.email ?? '', ...invitation.guests.map((guest) => guest.name)].join(' ').toLocaleLowerCase('ca-ES');
  const matchesSearch = !search || text.includes(search.toLocaleLowerCase('ca-ES'));
  const matchesStatus = statusFilter === 'all' || (statusFilter === 'sent' ? Boolean(invitation.sent_at) && !invitation.revoked_at : statusFilter === 'unsent' ? !invitation.sent_at && !invitation.revoked_at : statusFilter === 'revoked' && Boolean(invitation.revoked_at));
  const matchesResponse = responseFilter === 'all' || (!invitation.revoked_at && invitation.guests.some((guest) => guest.response === responseFilter));
  const matchesGroup = groupFilter === 'all' || (groupFilter === 'none' ? !invitation.group_id : invitation.group_id === groupFilter);
  return matchesSearch && matchesStatus && matchesResponse && matchesGroup;
});
const managementPage = paginateItems(filteredInvitations, Astro.url.searchParams.get('page'));
const groupPage = paginateItems(groups, Astro.url.searchParams.get('page'));
const managementPageHref = (page: number) => {
  const url = new URL('/admin/gestion', Astro.url);
  if (search) url.searchParams.set('q', search);
  if (statusFilter !== 'all') url.searchParams.set('status', statusFilter);
  if (responseFilter !== 'all') url.searchParams.set('response', responseFilter);
  if (groupFilter !== 'all') url.searchParams.set('group', groupFilter);
  url.searchParams.set('page', String(page));
  return url.pathname + url.search;
};
const groupPageHref = (page: number) => `/admin/gestion?view=grups&page=${page}`;
---
<BaseLayout title="Configuració i gestió · Boda" privatePage>
  <div class="admin-shell">
    <header class="admin-header">
      <div><p class="eyebrow">Espai dels nuvis</p><h1>Configuració i gestió</h1></div>
      <form method="post"><input type="hidden" name="action" value="logout" /><button type="submit" class="admin-link">Tanca la sessió</button></form>
    </header>
    <AdminNav active={view === 'grups' ? 'grups' : view === 'ajustos' ? 'ajustos' : 'invitacions'} />
    {error && view !== 'nova' && <p class="form-message form-message--error" role="alert">{error}</p>}
    {Astro.url.searchParams.has('saved') && <p class="form-message form-message--success" role="status">Configuració guardada.</p>}
    {Astro.url.searchParams.has('groupSaved') && <p class="form-message form-message--success" role="status">Grup i idioma guardats.</p>}
    {Astro.url.searchParams.has('deleted') && <p class="form-message form-message--success" role="status">Invitació i respostes eliminades.</p>}
    {Astro.url.searchParams.has('sentSaved') && <p class="form-message form-message--success" role="status">Estat d’enviament guardat.</p>}
    {Astro.url.searchParams.has('invitationSaved') && <p class="form-message form-message--success" role="status">Invitació actualitzada.</p>}
    {(view === 'invitacions' || view === 'nova') && <main class="admin-section" aria-labelledby="existing-title">
      <div class="admin-section__heading"><div><p class="eyebrow">Gestiona</p><h2 id="existing-title">Invitacions</h2></div><div class="admin-section__actions"><a href="/admin/export.csv">Baixa el CSV</a><a class="button button--primary" href="/admin/gestion?view=nova" data-open-invitation>Afig una invitació</a></div></div>
      <form method="get" action="/admin/gestion" class="admin-management-filters" role="search">
        <label for="invitation-q">Busca per nom o correu<input id="invitation-q" name="q" type="search" value={search} /></label>
        <label for="invitation-status">Enviament<select id="invitation-status" name="status"><option value="all" selected={statusFilter === 'all'}>Tots</option><option value="unsent" selected={statusFilter === 'unsent'}>Sense enviar</option><option value="sent" selected={statusFilter === 'sent'}>Enviades</option><option value="revoked" selected={statusFilter === 'revoked'}>Revocades</option></select></label>
        <label for="invitation-response">Assistència<select id="invitation-response" name="response"><option value="all" selected={responseFilter === 'all'}>Totes</option><option value="yes" selected={responseFilter === 'yes'}>Assistiran</option><option value="no" selected={responseFilter === 'no'}>No assistiran</option><option value="pending" selected={responseFilter === 'pending'}>Pendents</option></select></label>
        <label for="invitation-group">Grup<select id="invitation-group" name="group"><option value="all" selected={groupFilter === 'all'}>Tots</option><option value="none" selected={groupFilter === 'none'}>Sense grup</option>{groups.map((group) => <option value={group.id} selected={groupFilter === group.id}>{group.name}</option>)}</select></label>
        <button class="button" type="submit">Filtra</button>
      </form>
      {responseFilterNote && <p class="admin-management-filter-note">Es mostren invitacions {responseFilterNote}.</p>}
      {filteredInvitations.length ? <div class="admin-table-wrap"><table class="admin-table admin-table--management"><thead><tr><th scope="col"><span class="admin-table__label"><AdminIcon name="person" />Nom</span></th><th scope="col"><span class="admin-table__label"><AdminIcon name="group" />Grup</span></th><th scope="col"><span class="admin-table__label"><AdminIcon name="copy" />Missatge</span></th><th scope="col"><span class="admin-table__label"><AdminIcon name="send" />Enviament</span></th><th scope="col"><span class="admin-table__label"><AdminIcon name="manage" />Gestió</span></th></tr></thead><tbody>{managementPage.items.map((invitation) => {
        const link = `${Astro.url.origin}${invitationPath(invitationToken(invitation.token_encrypted), invitation.locale)}`;
        return <tr data-invitation-id={invitation.id} data-invitation-name={invitation.addressee} data-invitation-group={invitation.group_id ?? ''} data-invitation-email={invitation.email ?? ''} data-invitation-note={invitation.personal_note ?? ''} data-invitation-note-uk={invitation.personal_note_uk ?? ''} data-invitation-responses={JSON.stringify(invitation.guests.map((guest) => ({ name: guest.name, response: guest.response, allergies: guest.allergies, observations: guest.observations, busSeat: guest.bus_seat, busRoute: guest.bus_route })))}>
          <th scope="row" data-label="Nom" class="admin-table__name">{invitation.addressee}{invitation.guests.length > 1 && <small>{invitation.guests.length} persones</small>}</th>
          <td data-label="Grup"><span class="admin-table__group">{groups.find((group) => group.id === invitation.group_id)?.name ?? 'Sense grup'}</span></td>
          <td data-label="Missatge"><button type="button" class="button admin-table__copy" data-copy-message={invitation.revoked_at ? undefined : invitationMessage(invitation.addressee, link, invitation.locale)} disabled={Boolean(invitation.revoked_at)}><AdminIcon name="copy" /><span data-copy-label>Copia missatge</span></button></td>
          <td data-label="Enviament">{invitation.revoked_at ? <span class="admin-table__state" data-state="revoked"><AdminIcon name="blocked" />Revocada</span> : <form method="post" action={Astro.url.pathname + Astro.url.search} class="admin-delivery-form"><input type="hidden" name="action" value="delivery" /><input type="hidden" name="invitationId" value={invitation.id} /><label class="admin-delivery-check"><input type="checkbox" name="sent" value="yes" checked={Boolean(invitation.sent_at)} /><span>{invitation.sent_at ? 'Enviada' : 'Sense enviar'}</span></label><noscript><button type="submit">Guarda</button></noscript></form>}</td>
          <td data-label="Gestió"><div class="admin-table__row-actions"><button type="button" data-open-modal="view" aria-label={`Veure la invitació de ${invitation.addressee}`} title="Veure"><AdminIcon name="view" /></button><button type="button" data-open-modal="edit" aria-label={`Editar la invitació de ${invitation.addressee}`} title="Editar"><AdminIcon name="edit" /></button><button type="button" data-open-modal="delete" aria-label={`Eliminar la invitació de ${invitation.addressee}`} title="Eliminar"><AdminIcon name="delete" /></button></div></td>
        </tr>;
      })}</tbody></table></div> : <p class="admin-empty">{invitations.length ? 'No hi ha invitacions que coincidisquen amb els filtres.' : 'Encara no hi ha invitacions. Afig la primera amb el botó de dalt.'}</p>}
      <AdminPagination {...managementPage} label="invitacions" href={managementPageHref} />
      <p class="admin-copy-status" data-copy-status role="status" aria-live="polite"></p>
    </main>}
    {(view === 'invitacions' || view === 'nova') && <dialog class="admin-dialog" aria-labelledby="new-title" open={view === 'nova'} data-invitation-dialog>
      <div class="admin-dialog__heading"><div><p class="eyebrow">Prepara</p><h2 id="new-title">Nova invitació</h2></div><a href="/admin/gestion" data-close-invitation aria-label="Tanca el formulari">Tanca ×</a></div>
      {error && view === 'nova' && <p class="form-message form-message--error" role="alert">{error}</p>}
      <form method="post" action="/admin/gestion?view=nova" class="admin-form admin-form--wide"><input type="hidden" name="action" value="create" />
        <label for="name">Nom</label><input id="name" name="name" maxlength="160" required autocomplete="name" value={submittedName} placeholder="Per exemple: Maria" />
        <label for="groupId">Grup</label><select id="groupId" name="groupId" required>{groups.map((group) => <option value={group.id} selected={group.id === (submittedGroup || defaultGroup?.id)}>{group.name} · {localeName[group.locale]}</option>)}</select>
        <button class="button button--primary" type="submit">Crea la invitació i l’enllaç</button>
      </form>
    </dialog>}
    {(view === 'invitacions' || view === 'nova') && <dialog class="admin-dialog" aria-labelledby="view-title" data-action-dialog="view">
      <div class="admin-dialog__heading"><div><p class="eyebrow">Persones convidades</p><h2 id="view-title">Persones de <span data-view-name></span></h2></div><button type="button" class="admin-link" data-close-modal>Tanca ×</button></div>
      <p data-no-responses>Encara no hi ha persones convidades.</p>
      <ul class="admin-response-list" data-response-list></ul>
    </dialog>}
    {(view === 'invitacions' || view === 'nova') && <dialog class="admin-dialog" aria-labelledby="edit-title" data-action-dialog="edit">
      <div class="admin-dialog__heading"><div><p class="eyebrow">Modifica</p><h2 id="edit-title">Edita la invitació</h2></div><button type="button" class="admin-link" data-close-modal>Tanca ×</button></div>
      <form method="post" action={Astro.url.pathname + Astro.url.search} class="admin-form"><input type="hidden" name="action" value="editInvitation" /><input type="hidden" name="invitationId" data-edit-id />
        <label for="edit-name">Nom de la invitació</label><input id="edit-name" name="addressee" maxlength="160" required />
        <label for="edit-group">Grup</label><select id="edit-group" name="groupId"><option value="">Sense grup</option>{groups.map((group) => <option value={group.id}>{group.name} · {localeName[group.locale]}</option>)}</select>
        <label for="edit-email">Correu de contacte (opcional)</label><input id="edit-email" name="email" type="email" maxlength="254" />
        <label for="edit-note">Missatge personal en valencià (opcional)</label><textarea id="edit-note" name="personalNote" rows="3" maxlength="1000"></textarea>
        <label for="edit-note-uk">Missatge personal en ucraïnés (opcional)</label><textarea id="edit-note-uk" name="personalNoteUk" rows="3" maxlength="1000"></textarea>
        <button class="button button--primary" type="submit">Guarda els canvis</button>
      </form>
      <a class="admin-dialog__detail-link" data-edit-detail>Edita les persones, respostes i l’enllaç →</a>
    </dialog>}
    {(view === 'invitacions' || view === 'nova') && <dialog class="admin-dialog admin-dialog--danger" aria-labelledby="delete-title" data-action-dialog="delete"><div class="admin-dialog__heading"><div><p class="eyebrow">Elimina definitivament</p><h2 id="delete-title">Elimina la invitació</h2></div><button type="button" class="admin-link" data-close-modal>Tanca ×</button></div><p>S’eliminaran l’enllaç i totes les respostes. Esta acció no es pot desfer.</p><form method="post" action={Astro.url.pathname + Astro.url.search} class="admin-form"><input type="hidden" name="action" value="deleteInvitation" /><input type="hidden" name="invitationId" data-delete-id /><label for="delete-name" data-delete-label></label><input id="delete-name" name="confirmName" autocomplete="off" required /><button class="button" type="submit">Elimina definitivament</button></form></dialog>}
    {view === 'grups' && <main class="admin-section" aria-labelledby="groups-title">
      <div class="admin-section__heading"><div><p class="eyebrow">Organitza</p><h2 id="groups-title">Grups i idiomes</h2></div></div>
      <section aria-labelledby="create-group-title"><h3 id="create-group-title">Afig un grup</h3><form method="post" action="/admin/gestion?view=grups" class="admin-form"><input type="hidden" name="action" value="createGroup" /><label for="new-group-name">Nom del grup</label><input id="new-group-name" name="name" maxlength="160" required placeholder="Per exemple: família d’Ucraïna" /><label for="new-group-locale">Idioma</label><select id="new-group-locale" name="locale"><option value="es">Valencià</option><option value="uk">Українська</option></select><button class="button button--primary" type="submit">Crea el grup</button></form></section>
      <section class="admin-group-list" aria-labelledby="current-groups-title">
        <h3 id="current-groups-title">Grups existents</h3>
        <p>Les invitacions d’un grup utilitzen el seu idioma. Si el canvies, també canvien els enllaços.</p>
        {groups.length ? <>
          {groupPage.items.map((group) => <form id={`group-form-${group.id}`} method="post" action={groupPageHref(groupPage.page)}><input type="hidden" name="action" value="editGroup" /><input type="hidden" name="groupId" value={group.id} /></form>)}
          <p id="group-scroll-hint" class="admin-group-table__hint">Desplaça la taula cap a la dreta per a veure l’idioma i guardar els canvis.</p>
          <div class="admin-group-table-wrap" role="region" aria-label="Taula de grups" aria-describedby="group-scroll-hint" tabindex="0">
            <table class="admin-group-table">
              <thead><tr><th scope="col">Nom del grup</th><th scope="col">Idioma del grup</th><th scope="col">Acció</th></tr></thead>
              <tbody>{groupPage.items.map((group) => <tr>
                <td><label class="admin-group-table__hidden-label" for={`group-name-${group.id}`}>Nom del grup {group.name}</label><input id={`group-name-${group.id}`} form={`group-form-${group.id}`} name="name" value={group.name} maxlength="160" required /></td>
                <td><label class="admin-group-table__hidden-label" for={`group-locale-${group.id}`}>Idioma del grup {group.name}</label><select id={`group-locale-${group.id}`} form={`group-form-${group.id}`} name="locale"><option value="es" selected={group.locale === 'es'}>Valencià</option><option value="uk" selected={group.locale === 'uk'}>Українська</option></select></td>
                <td><button class="button" form={`group-form-${group.id}`} type="submit" aria-label={`Guarda el grup ${group.name}`}>Guarda el grup</button></td>
              </tr>)}</tbody>
            </table>
          </div>
          <AdminPagination {...groupPage} label="grups" href={groupPageHref} />
        </> : <p class="admin-empty">Encara no hi ha grups. Afig el primer grup amb el formulari de dalt.</p>}
      </section>
    </main>}
    {view === 'ajustos' && <main class="admin-section" aria-labelledby="settings-title"><div class="admin-section__heading"><div><p class="eyebrow">Control</p><h2 id="settings-title">Termini de confirmació</h2></div></div><form method="post" action="/admin/gestion?view=ajustos" class="admin-form"><input type="hidden" name="action" value="settings" /><label class="admin-checkbox"><input type="checkbox" name="enabled" value="yes" checked={config.rsvp_enabled} /> Permet les respostes</label><label for="deadline">Data límit (opcional)</label><input type="date" id="deadline" name="deadline" value={config.rsvp_deadline ?? ''} /><button class="button button--primary" type="submit">Guarda la configuració</button></form></main>}
  </div>
  <script>
    const actionDialogs = {
      view: document.querySelector<HTMLDialogElement>('[data-action-dialog="view"]'),
      edit: document.querySelector<HTMLDialogElement>('[data-action-dialog="edit"]'),
      delete: document.querySelector<HTMLDialogElement>('[data-action-dialog="delete"]'),
    };
    document.querySelectorAll<HTMLButtonElement>('[data-open-modal]').forEach((button) => button.addEventListener('click', () => {
      const row = button.closest<HTMLTableRowElement>('tr[data-invitation-id]');
      const kind = button.dataset.openModal as keyof typeof actionDialogs;
      const dialog = actionDialogs[kind];
      if (!row || !dialog) return;
      const { invitationId: id = '', invitationName: name = '', invitationGroup: groupId = '' } = row.dataset;
      if (kind === 'view') {
        const heading = dialog.querySelector<HTMLElement>('[data-view-name]');
        const list = dialog.querySelector<HTMLUListElement>('[data-response-list]');
        const empty = dialog.querySelector<HTMLElement>('[data-no-responses]');
        if (heading) heading.textContent = name;
        if (list) {
          list.replaceChildren();
          type Answer = { name: string; response: 'pending' | 'yes' | 'no'; allergies: string; observations: string; busSeat: boolean | null; busRoute: string | null };
          const answers = JSON.parse(row.dataset.invitationResponses ?? '[]') as Answer[];
          if (empty) empty.hidden = answers.length > 0;
          const addDetail = (parent: HTMLElement, label: string, value: string) => {
            const paragraph = document.createElement('p');
            const title = document.createElement('strong');
            title.textContent = `${label}: `;
            paragraph.append(title, document.createTextNode(value));
            parent.append(paragraph);
          };
          for (const answer of answers) {
            const item = document.createElement('li');
            const guestName = document.createElement('h3');
            guestName.textContent = answer.name;
            item.append(guestName);
            addDetail(item, 'Assistència', answer.response === 'yes' ? 'Assistirà' : answer.response === 'no' ? 'No assistirà' : 'Pendent');
            if (answer.response === 'yes') {
              if (answer.allergies) addDetail(item, 'Al·lèrgies', answer.allergies);
              if (answer.observations) addDetail(item, 'Observacions', answer.observations);
              const route = answer.busRoute === 'outbound' ? 'Només anada' : answer.busRoute === 'return' ? 'Només tornada' : answer.busRoute === 'both' ? 'Anada i tornada' : 'Sense trajecte';
              addDetail(item, 'Autobús', answer.busSeat === true ? route : answer.busSeat === false ? 'No' : 'Sense resposta');
            }
            list.append(item);
          }
        }
      } else if (kind === 'edit') {
        const idInput = dialog.querySelector<HTMLInputElement>('[data-edit-id]');
        const nameInput = dialog.querySelector<HTMLInputElement>('#edit-name');
        const groupSelect = dialog.querySelector<HTMLSelectElement>('#edit-group');
        const emailInput = dialog.querySelector<HTMLInputElement>('#edit-email');
        const noteInput = dialog.querySelector<HTMLTextAreaElement>('#edit-note');
        const noteUkInput = dialog.querySelector<HTMLTextAreaElement>('#edit-note-uk');
        const detail = dialog.querySelector<HTMLAnchorElement>('[data-edit-detail]');
        if (idInput) idInput.value = id;
        if (nameInput) nameInput.value = name;
        if (groupSelect) groupSelect.value = groupId;
        if (emailInput) emailInput.value = row.dataset.invitationEmail ?? '';
        if (noteInput) noteInput.value = row.dataset.invitationNote ?? '';
        if (noteUkInput) noteUkInput.value = row.dataset.invitationNoteUk ?? '';
        if (detail) detail.href = `/admin/invitations/${id}`;
      } else {
        const idInput = dialog.querySelector<HTMLInputElement>('[data-delete-id]');
        const label = dialog.querySelector<HTMLLabelElement>('[data-delete-label]');
        const confirmation = dialog.querySelector<HTMLInputElement>('#delete-name');
        if (idInput) idInput.value = id;
        if (label) label.textContent = `Escriu «${name}» per a confirmar`;
        if (confirmation) confirmation.value = '';
      }
      dialog.showModal();
    }));
    document.querySelectorAll<HTMLButtonElement>('[data-close-modal]').forEach((button) => button.addEventListener('click', () => button.closest('dialog')?.close()));
    document.querySelectorAll<HTMLFormElement>('.admin-delivery-form').forEach((form) => {
      form.querySelector<HTMLInputElement>('input[name="sent"]')?.addEventListener('change', () => form.requestSubmit());
    });
    const dialog = document.querySelector<HTMLDialogElement>('[data-invitation-dialog]');
    if (dialog && typeof dialog.showModal === 'function') {
      if (dialog.hasAttribute('open')) { dialog.removeAttribute('open'); dialog.showModal(); }
      document.querySelector<HTMLAnchorElement>('[data-open-invitation]')?.addEventListener('click', (event) => {
        event.preventDefault();
        dialog.showModal();
        dialog.querySelector<HTMLInputElement>('[name="name"]')?.focus();
      });
      dialog.querySelector<HTMLAnchorElement>('[data-close-invitation]')?.addEventListener('click', (event) => {
        event.preventDefault();
        dialog.close();
      });
      dialog.addEventListener('close', () => {
        if (new URLSearchParams(location.search).get('view') === 'nova') history.replaceState(null, '', '/admin/gestion');
      });
    }
    const status = document.querySelector<HTMLElement>('[data-copy-status]');
    document.querySelectorAll<HTMLButtonElement>('[data-copy-message]').forEach((button) => button.addEventListener('click', async () => {
      const message = button.dataset.copyMessage;
      if (!message || !status) return;
      try { await navigator.clipboard.writeText(message); const label = button.querySelector<HTMLElement>('[data-copy-label]'); if (label) label.textContent = 'Missatge copiat'; status.textContent = 'Missatge amb enllaç copiat.'; }
      catch { window.prompt('Copia este missatge:', message); status.textContent = 'Copia el missatge del quadre de diàleg.'; }
    }));
  </script>
</BaseLayout>
