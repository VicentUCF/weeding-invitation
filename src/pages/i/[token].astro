---
import InvitationExperience from '../../components/invitation/InvitationExperience.astro';
import { invitationByToken, settings, canRespond, saveRsvp } from '../../lib/invitations.server';
import { rsvpInput } from '../../lib/forms.server';
import { validToken } from '../../lib/tokens';
import { sameOrigin } from '../../lib/security.server';
import { invitationPath, t } from '../../lib/i18n';

export const prerender = false;
const c = t('es');
const token = Astro.params.token ?? '';
if (!validToken(token)) return new Response(c.notFound, { status: 404 });
let invitation;
let config;
try {
  [invitation, config] = await Promise.all([invitationByToken(token), settings()]);
} catch {
  return new Response(c.unavailable, { status: 503 });
}
if (!invitation) return new Response(c.notFound, { status: 404 });
const forcedSpanish = Astro.url.searchParams.get('lang') === 'es';
if (invitation.locale === 'uk' && !forcedSpanish) return Astro.redirect(invitationPath(token, 'uk'), 302);

let error = '';
let submitted: FormData | undefined;
if (Astro.request.method === 'POST') {
  const json = Astro.request.headers.get('accept') === 'application/json';
  if (!sameOrigin(Astro)) return new Response(c.invalidOrigin, { status: 403 });
  if (!canRespond(config)) return json ? new Response(JSON.stringify({ error: c.deadlineClosed }), { status: 403, headers: { 'Content-Type': 'application/json', 'Cache-Control': 'private, no-store' } }) : new Response(c.deadlineClosed, { status: 403 });
  let responses;
  try {
    submitted = await Astro.request.formData();
    responses = rsvpInput(submitted, invitation.guests, 'es');
  } catch (cause) {
    error = cause instanceof Error ? cause.message : c.rsvpInvalid;
  }
  if (responses) {
    try {
      await saveRsvp(invitation.id, responses);
      if (json) return new Response(JSON.stringify({ guests: responses.map((response) => ({ name: invitation.guests.find((guest) => guest.id === response.id)?.name ?? '', response: response.response })) }), { headers: { 'Content-Type': 'application/json', 'Cache-Control': 'private, no-store' } });
      return Astro.redirect(`${invitationPath(token, 'es')}?${forcedSpanish ? 'lang=es&' : ''}saved=1#confirmar`, 303);
    } catch {
      error = c.rsvpSaveError;
    }
  }
  if (json) return new Response(JSON.stringify({ error }), { status: 400, headers: { 'Content-Type': 'application/json', 'Cache-Control': 'private, no-store' } });
}
const recipient = { token, addressee: invitation.addressee, guests: invitation.guests.map((guest) => guest.name), personalNote: invitation.personal_note ?? undefined };
---
<InvitationExperience recipient={recipient} invitation={invitation} rsvpSettings={config} rsvpError={error} rsvpSaved={Astro.url.searchParams.get('saved') === '1'} rsvpSubmitted={submitted} locale="es" />
